{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nwilbert.github.io/pytest-given/latest/schemas/report-v1.schema.json",
  "$defs": {
    "Attachment": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "content_type": {
          "$ref": "#/$defs/ContentType",
          "default": "text"
        }
      },
      "required": [
        "label",
        "content",
        "content_type"
      ],
      "type": "object"
    },
    "AttachmentRef": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "content_type": {
          "$ref": "#/$defs/ContentType"
        },
        "column_id": {
          "description": "The parameter column whose cells hold the content, which varies by case.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "content_type",
        "column_id"
      ],
      "type": "object"
    },
    "CellValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParamValue"
        },
        {
          "$ref": "#/$defs/Attachment"
        }
      ]
    },
    "Clause": {
      "additionalProperties": false,
      "properties": {
        "parts": {
          "items": {
            "$ref": "#/$defs/ClausePart"
          },
          "type": "array"
        }
      },
      "required": [
        "parts"
      ],
      "type": "object"
    },
    "ClausePart": {
      "anyOf": [
        {
          "$ref": "#/$defs/NarrationLiteral"
        },
        {
          "$ref": "#/$defs/NarrationTermRef"
        }
      ]
    },
    "ColumnKind": {
      "enum": [
        "param",
        "derived",
        "attachment"
      ],
      "type": "string"
    },
    "ContentType": {
      "enum": [
        "text",
        "json"
      ],
      "type": "string"
    },
    "Definition": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/DefinitionPart"
          },
          "type": "array"
        }
      },
      "required": [
        "text",
        "parts"
      ],
      "type": "object"
    },
    "DefinitionPart": {
      "anyOf": [
        {
          "$ref": "#/$defs/NarrationLiteral"
        },
        {
          "$ref": "#/$defs/NarrationTermRef"
        }
      ]
    },
    "ErrorCause": {
      "additionalProperties": false,
      "properties": {
        "frames": {
          "items": {
            "$ref": "#/$defs/TracebackFrame"
          },
          "type": "array"
        },
        "error_tail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "connector": {
          "type": "string"
        }
      },
      "required": [
        "frames",
        "error_tail",
        "connector"
      ],
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/TracebackFrame"
          },
          "type": "array"
        },
        "error_tail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "causes": {
          "items": {
            "$ref": "#/$defs/ErrorCause"
          },
          "type": "array"
        }
      },
      "required": [
        "message",
        "frames",
        "error_tail",
        "causes"
      ],
      "type": "object"
    },
    "Glossary": {
      "additionalProperties": false,
      "properties": {
        "terms": {
          "items": {
            "$ref": "#/$defs/GlossaryTerm"
          },
          "type": "array"
        }
      },
      "required": [
        "terms"
      ],
      "type": "object"
    },
    "GlossaryTerm": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when no kind was declared or inferred."
        },
        "canonical": {
          "type": "string"
        },
        "definition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Definition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avoid": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "canonical",
        "definition",
        "source",
        "section",
        "avoid"
      ],
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "pytest_version": {
          "type": "string"
        },
        "plugin_version": {
          "type": "string"
        },
        "commit_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "report_url": {
          "anyOf": [
            {
              "format": "uri",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "report",
          "default": "report",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/ReportSchemaVersion",
          "default": 1
        }
      },
      "required": [
        "project",
        "timestamp",
        "pytest_version",
        "plugin_version",
        "commit_sha",
        "title",
        "report_url",
        "kind",
        "schema_version"
      ],
      "type": "object"
    },
    "Narration": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "parts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NarrationPart"
          },
          "type": "array"
        }
      },
      "required": [
        "text",
        "parts"
      ],
      "type": "object"
    },
    "NarrationLiteral": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "NarrationPart": {
      "anyOf": [
        {
          "$ref": "#/$defs/NarrationLiteral"
        },
        {
          "$ref": "#/$defs/NarrationValue"
        },
        {
          "$ref": "#/$defs/NarrationPlaceholder"
        },
        {
          "$ref": "#/$defs/NarrationTermRef"
        }
      ]
    },
    "NarrationPlaceholder": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "column_id": {
          "description": "The parameter column whose cells fill it in.",
          "type": "string"
        },
        "format_spec": {
          "default": "",
          "type": "string"
        },
        "conversion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "column_id",
        "format_spec",
        "conversion"
      ],
      "type": "object"
    },
    "NarrationTermRef": {
      "additionalProperties": false,
      "properties": {
        "term_id": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "expression": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "term_id",
        "display",
        "expression"
      ],
      "type": "object"
    },
    "NarrationValue": {
      "additionalProperties": false,
      "properties": {
        "rendered": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "format_spec": {
          "default": "",
          "type": "string"
        },
        "conversion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rendered",
        "expression",
        "format_spec",
        "conversion"
      ],
      "type": "object"
    },
    "ParamValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "ParameterCase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "values": {
          "description": "One cell per column, in the order of the table's columns. What a cell holds depends on its column's kind. Null is a parametrize value in a param column and no value in any other.",
          "items": {
            "$ref": "#/$defs/CellValue"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "passed"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "custom_id": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "values",
        "status",
        "error",
        "custom_id"
      ],
      "type": "object"
    },
    "ParameterColumn": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ColumnKind"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "type": "object"
    },
    "ParameterTable": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/ParameterColumn"
          },
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/ParameterCase"
          },
          "type": "array"
        }
      },
      "required": [
        "columns",
        "cases"
      ],
      "type": "object"
    },
    "Phase": {
      "enum": [
        "given",
        "when",
        "then"
      ],
      "type": "string"
    },
    "Pin": {
      "additionalProperties": false,
      "properties": {
        "story_id": {
          "type": "string"
        },
        "sentence_id": {
          "type": "integer"
        }
      },
      "required": [
        "story_id",
        "sentence_id"
      ],
      "type": "object"
    },
    "ReportSchemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "The pytest node ID. A grouped parametrized scenario keeps its first case's.",
          "type": "string"
        },
        "narration": {
          "$ref": "#/$defs/Narration"
        },
        "module": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "passed"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "parameters": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParameterTable"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null on a grouped parametrized scenario, whose cases each hold their own."
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why it was skipped or expected to fail, as its status says. Null for any other status."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "story_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pins": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Pin"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when nothing pins it. An empty array when pinning turned narration matching off."
        }
      },
      "required": [
        "id",
        "narration",
        "module",
        "tags",
        "status",
        "duration_ms",
        "steps",
        "parameters",
        "error",
        "reason",
        "source",
        "story_ids",
        "pins"
      ],
      "type": "object"
    },
    "Sentence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "clauses": {
          "items": {
            "$ref": "#/$defs/Clause"
          },
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "clauses",
        "name"
      ],
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "relpath": {
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "relpath",
        "line"
      ],
      "type": "object"
    },
    "Status": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "xfailed"
      ],
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "narration": {
          "$ref": "#/$defs/Narration"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/StepAttachment"
          },
          "type": "array"
        },
        "pins": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Pin"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when nothing pins it. An empty array when pinning turned narration matching off."
        },
        "fixture_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "phase",
        "narration",
        "children",
        "attachments",
        "pins",
        "fixture_name"
      ],
      "type": "object"
    },
    "StepAttachment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Attachment"
        },
        {
          "$ref": "#/$defs/AttachmentRef"
        }
      ]
    },
    "Story": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sentences": {
          "items": {
            "$ref": "#/$defs/Sentence"
          },
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "sentences",
        "source"
      ],
      "type": "object"
    },
    "TermKind": {
      "enum": [
        "actor",
        "object",
        "activity"
      ],
      "type": "string"
    },
    "TracebackFrame": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "lineno": {
          "type": "integer"
        },
        "func": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "is_internal": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "lineno",
        "func",
        "code",
        "is_internal"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "default": "https://nwilbert.github.io/pytest-given/latest/schemas/report-v1.schema.json",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "type": "array"
    },
    "glossary": {
      "anyOf": [
        {
          "$ref": "#/$defs/Glossary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stories": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Story"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "metadata",
    "scenarios",
    "glossary",
    "stories"
  ],
  "type": "object"
}
