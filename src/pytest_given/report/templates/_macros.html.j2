{#
  Macros shared by the report's three views.

  Kept out of report.html.j2 so the page reads as its own structure — header,
  tabs, the three views — rather than opening with 120 lines of helpers.
  Imported `with context`, so the environment's filters resolve exactly as
  they did inline.

  The two-space indent is deliberate: it keeps the rendered HTML identical to
  when these lines sat inline.
#}
  {#- A scenario's status as the badge the Scenarios and Stories views both
      show, and as the bare dot in a parameter table's status column. The glyph comes
      from `STATUS_GLYPH` through the `status_glyph` filter, so the Markdown
      sink and every place here paint one run the same way. -#}
  {%- macro status_badge(status) -%}
    <span class="scenario-status {{ status }}">{{ status | status_glyph }} {{ status | status_label }}</span>
  {%- endmacro -%}

  {%- macro status_dot(status) -%}
    <span class="dot-{{ status }}">{{ status | status_glyph }}</span>
  {%- endmacro -%}

  {#- The drag handle between a sidebar and its view. Every view renders one,
      and they all drive the same `sidebarWidth`, so the three sidebars stay
      the same width — a reader who widens one in Scenarios finds Glossary
      already widened. Focusable and arrow-key adjustable: a 5px target is not
      one everyone can hit. -#}
  {%- macro sidebar_resizer() -%}
    <div class="sidebar-resize" role="separator" aria-orientation="vertical"
         aria-label="Sidebar width" tabindex="0"
         :aria-valuenow="sidebarWidth" aria-valuemin="180" aria-valuemax="480"
         @pointerdown="startSidebarResize($event)"
         @dblclick="resetSidebar()"
         @keydown.arrow-left.prevent="nudgeSidebar(-16)"
         @keydown.arrow-right.prevent="nudgeSidebar(16)"
         @keydown.home.prevent="resetSidebar()"></div>
  {%- endmacro -%}

  {%- macro source_link(source) -%}
    {%- if source -%}
      {%- set url = source | source_url -%}
      {%- if url -%}
      <a href="{{ url }}">{{ source.relpath }}:{{ source.line }}</a>
      {%- else -%}
      <span>{{ source.relpath }}:{{ source.line }}</span>
      {%- endif -%}
    {%- endif -%}
  {%- endmacro -%}

  {#- The icons that repeat once per card, header or attachment — hundreds of
      times in a large report — are defined once per page and drawn by
      `icon`. The citation icon is the Markdown mark's "M↓" without its box,
      which leaves too little room for the letters at 14px: it copies a line
      of Markdown, not a URL. The narrated citation's is the same mark, raised
      above two lines of the body it folds: still Markdown, with more of it. -#}
  {%- macro icon_sprite() -%}
    <svg class="svg-sprite" aria-hidden="true">
      <symbol id="icon-link" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></g></symbol>
      <symbol id="icon-json" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/></g></symbol>
      <symbol id="icon-text" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></g></symbol>
      {%- if citations %}
      <symbol id="icon-citation" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18V6l5 5.5L12 6v12"/><path d="M18.5 6v12"/><path d="m14.5 14 4 4 4-4"/></g></symbol>
      <symbol id="icon-copy" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="13" height="13" x="9" y="9" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></g></symbol>
      <symbol id="icon-narrated" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12V3l5 5 5-5v9"/><path d="M18.5 3v9"/><path d="m15 9 3.5 3.5L22 9"/><path d="M2 17h20"/><path d="M2 21.5h12"/></g></symbol>
      {%- endif %}
    </svg>
  {%- endmacro -%}

  {%- set citation_title = 'Copy Markdown citation. pytest-given citations check and update keep it current.' -%}

  {%- macro icon(name, class=none) -%}
    <svg{% if class %} class="{{ class }}"{% else %} width="14" height="14"{% endif %} aria-hidden="true"><use href="#icon-{{ name }}"/></svg>
  {%- endmacro -%}

  {%- macro anchor_link(hash) -%}
    <button type="button" class="anchor-link" title="Copy link" data-anchor="{{ hash }}" @click.stop="copyAnchor($el)" aria-label="Copy link">{{ icon('link') }}</button>
  {%- endmacro -%}

  {#- A scenario card's or story header's copy button. Without a report URL a
      link is all there is to copy, so the button copies it directly; with
      one, it opens the shared copy menu. Keys travel as data-* and are read
      back from the dataset: Alpine compiles a directive's decoded attribute
      text as JS, so interpolating a node ID into one would be an injection. -#}
  {%- macro copy_button(kind, key, hash) -%}
    {%- if citations -%}
    <button type="button" class="anchor-link copy-menu-trigger" title="Copy link or citation" aria-label="Copy link or citation" aria-haspopup="menu" aria-expanded="false" data-anchor="{{ hash }}" data-citation-kind="{{ kind }}" data-citation-key="{{ key }}" @click.stop="toggleCopyMenu($el)">{{ icon('copy') }}</button>
    {%- else -%}
    {{ anchor_link(hash) }}
    {%- endif -%}
  {%- endmacro -%}

  {#- Why a scenario was skipped or expected to fail, in its status colour. -#}
  {%- macro reason_box(status, label, reason) -%}
    <div class="reason-box {{ status }}">
      <span class="reason-box-label">{{ label }}</span>
      <span>{{ reason }}</span>
    </div>
  {%- endmacro -%}

  {#- The status colours the block: an xfailed one is not an alarm. -#}
  {%- macro render_error(error, status) -%}
    {%- set chained_frames = error.causes | map(attribute='frames') | sum(start=[]) -%}
    {%- set internal_count = (chained_frames + error.frames) | selectattr('is_internal') | list | length -%}
    <div class="error-block {{ status }}"{% if internal_count %} x-data="{ showInternal: false }"{% endif %}>
      <div class="error-message">{{ error.message }}</div>
      {%- if internal_count -%}
        <button class="error-toggle" type="button" @click="showInternal = !showInternal">
          <span x-show="!showInternal">Show {{ internal_count }} internal frame{{ '' if internal_count == 1 else 's' }}</span>
          <span x-show="showInternal" x-cloak>Hide internal frames</span>
        </button>
      {%- endif -%}
      {#- A chained error reads as pytest prints it: each cause, root first,
          then the sentence leading on to the next, then the error's own. -#}
      {%- for cause in error.causes -%}
        {{ render_frames(cause.frames, cause.error_tail) }}
        <div class="error-connector">{{ cause.connector }}</div>
      {%- endfor -%}
      {{ render_frames(error.frames, error.error_tail) }}
    </div>
  {%- endmacro -%}

  {%- macro render_frames(frames, tail) -%}
    {%- if frames -%}
      <div class="error-frames">
        {%- for f in frames -%}
          <div class="error-frame{% if f.is_internal %} error-frame-internal{% endif %}"
               {%- if f.is_internal %} x-show="showInternal" x-cloak{% endif -%}>
            <div class="error-frame-loc">{{ f.path }}:{{ f.lineno }}: in {{ f.func }}</div>
            <pre class="error-frame-code">{{ f.code }}</pre>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if tail -%}<pre class="error-tail">{{ tail }}</pre>{%- endif -%}
  {%- endmacro -%}

  {#- `step_id` is interpolated straight into the Alpine expressions below,
      which is only safe because every caller builds it from loop indices
      ('s0_1_2') and never from report data. Alpine compiles a directive's
      decoded attribute text as JS, so a value carrying a `'` would break out
      of the string literal — HTML-escaping does not stop that. Anything
      data-derived goes in a `data-*` attribute and is read via
      `$el.dataset.*`, as `data-tag` and `data-term-id` do. -#}
  {#- The glyph names what the payload is, rather than that there is one:
      braces for JSON, a page for text. Anything but 'json' takes the page —
      a content type this template has not met reads as text, which is what
      an unrecognized payload is displayed as anyway. -#}
  {%- macro attachment_icon(content_type) -%}
    {{- icon('json' if content_type == 'json' else 'text', 'attachment-badge-icon') -}}
  {%- endmacro -%}

  {#- Badge plus the payload it expands, keyed on `cell_id`; a promoted
      attachment has no payload of its own to expand. Operable rather than
      decorated text: reachable by keyboard and announced as a control. -#}
  {%- macro attachment_badge(cell_id, label, content_type) -%}
    <button type="button" class="btn-reset attachment-badge"
            :aria-expanded="!!expandedAttachments['{{ cell_id }}']"
            @click="toggleAttachment('{{ cell_id }}')">{{ attachment_icon(content_type) }}{{ label }}</button>
  {%- endmacro -%}

  {%- macro expandable_attachment(cell_id, label, content, content_type) -%}
    {{ attachment_badge(cell_id, label, content_type) }}
    <div class="attachment-expand" :class="{ expanded: expandedAttachments['{{ cell_id }}'] }">
      <div class="attachment-expand-inner">
        <div class="attachment-content"><pre>{{ content }}</pre></div>
      </div>
    </div>
  {%- endmacro -%}

  {%- macro render_step(step, step_id) -%}
  <div class="step-text">
    {%- if step.children and step.children | length > 0 -%}
      <span class="step-toggle" @click="toggleStep('{{ step_id }}')">
        <button type="button" class="disclosure-btn"
                :aria-expanded="!!expandedSteps['{{ step_id }}']"
                :aria-label="(expandedSteps['{{ step_id }}'] ? 'Collapse' : 'Expand') + ' sub-steps'"
                @click.stop="toggleStep('{{ step_id }}')"><span class="step-chevron" :class="{ 'step-chevron-open': expandedSteps['{{ step_id }}'] }"></span></button>
        {{ step.narration | narration }}
      </span>
    {%- else -%}
      {{ step.narration | narration }}
    {%- endif -%}
  </div>
  {%- if step.children and step.children | length > 0 -%}
    <div class="step-expand" :class="{ expanded: expandedSteps['{{ step_id }}'] }">
      <div class="step-children">
        {%- for child in step.children -%}
          {{ render_step(child, step_id ~ '_' ~ loop.index0) }}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
  {%- if step.attachments -%}
    {%- for att in step.attachments -%}
    {%- if att is attachment_ref -%}
    <div>
      <span class="attachment-badge attachment-badge--static" data-param="{{ att.column_id }}">{{ attachment_icon(att.content_type) }}{{ att.label }}</span>
    </div>
    {%- else -%}
    <div>
      {{ expandable_attachment(step_id ~ '_att_' ~ loop.index0, att.label, att.content, att.content_type) }}
    </div>
    {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- endmacro -%}
