{#
  What the delta page adds to the report's macros: the Change filter, a
  changed scenario's two sides (the report's phase blocks and step lines,
  each step's change marked on its side, styled as `.delta-step`, and the
  parameter tables), and a listed term's card.
#}
  {%- from '_macros.html.j2' import source_link, anchor_link, render_step, step_text, step_children, step_attachments, scenario_steps, param_table, attachment_cell, case_extras, status_dot with context -%}

  {#- The Change filter's pills, each disabled at zero, and how many items
      matched with no change. `model` is the Alpine property the pills
      toggle: a name from the template, never report data. -#}
  {%- macro change_filter(model, counts, unchanged_count) -%}
    <div class="sidebar-section">
      <div class="sidebar-label">Change</div>
      <div class="status-pills">
        {%- for change, count in counts.items() %}
        <button type="button" class="btn-reset status-pill delta-change-pill" data-change="{{ change }}" :class="{ 'active-change': {{ model }}.{{ change }} }" :aria-pressed="{{ model }}.{{ change }}" @click="{{ model }}.{{ change }} = !{{ model }}.{{ change }}"{% if not count %} disabled{% endif %}>{{ change_glyph[change] }} {{ change | capitalize }} <span>{{ count }}</span></button>
        {%- endfor %}
      </div>
      <div class="delta-unchanged">{{ unchanged_count }} unchanged</div>
    </div>
  {%- endmacro -%}

  {#- A listed term's card, a row as the report's Glossary entry is: its
      name (a renamed term's old one under it), a changed term's two
      definitions side by side or an added or removed one's own, and its
      change; its bar its change too. Opening it shows each side's other
      forms and scenario count, in that side's column, then links the listed
      scenarios that refer to it, each into the Scenarios tab
      (`data-goto-scenario`). -#}
  {%- macro term_card(card) -%}
        {%- set term = card.shown %}
        {%- set key = card.key %}
        <div class="entry" id="term-{{ key }}" data-change="{{ card.change }}"
             data-search="{{ card.search_text }}"
             x-show="shownTermChanges.{{ card.change }} && (glossaryDefinitionFilter === 'all' || (glossaryDefinitionFilter === 'undefined') === {{ 'true' if term.definition is none else 'false' }}) && (!glossarySearch || $el.dataset.search.includes(glossarySearch.toLowerCase()))">
          <div class="entry-head" data-term-id="{{ key }}" @click="toggleTerm($el.dataset.termId)">
            <button type="button" class="disclosure-btn" data-term-id="{{ key }}"
                    aria-controls="term-refs-{{ key }}"
                    :aria-expanded="!!expandedTerms[$el.dataset.termId]"
                    :aria-label="(expandedTerms[$el.dataset.termId] ? 'Collapse' : 'Expand') + ' references'"
                    @click.stop="toggleTerm($el.dataset.termId)"><span class="scenario-chevron" data-term-id="{{ key }}" :class="{ 'scenario-chevron-open': expandedTerms[$el.dataset.termId] }"></span></button>
            <span class="entry-name delta-title">
              <span class="term-name">{% if card.change == 'removed' %}<del>{{ term.canonical }}</del>{% else %}{{ term.canonical }}{% endif %}{{ anchor_link('view=glossary&term=' ~ key) }}</span>
              {%- if card.renamed_from %}
              <span class="delta-was">was <del>{{ card.renamed_from }}</del></span>
              {%- endif %}
            </span>
            <div class="entry-body">
              <div class="delta-sides{% if card.sides | length == 1 %} delta-one-side{% endif %}">
                {%- if card.sides | length == 2 %}{{ delta_rule() }}{% endif %}
                {%- for side in card.sides %}
                {%- set version = card.term(side) %}
                {%- set words = card.definition(side) %}
                {%- set forms = card.other_forms(side) %}
                {%- set count = card.scenario_count(side) %}
                <div class="delta-term-side" data-side="{{ side }}">
                  <div class="entry-def">
                    {%- if words %}{{ words | definition_diff }}{% else %}{{ version.definition | inline_md }}{% endif -%}
                    {%- if version.definition is none %}<span class="entry-def-badge">Undefined</span>{% endif -%}
                  </div>
                  {%- if forms or count %}
                  <div class="delta-term-more" data-term-id="{{ key }}" :class="{ expanded: expandedTerms[$el.dataset.termId] }">
                    <div class="delta-term-more-inner">
                      {%- if forms %}
                      <div class="delta-term-forms">
                        {%- for form in forms %}
                        {%- if form.change == 'removed' %}
                        <del class="use-chip use-chip--static delta-form" data-change="removed" title="Removed form">{{ form.text }}</del>
                        {%- elif form.change == 'added' %}
                        <span class="use-chip use-chip--static delta-form" data-change="added" title="Added form">+{{ form.text }}</span>
                        {%- else %}
                        <span class="use-chip use-chip--static">{{ form.text }}</span>
                        {%- endif %}
                        {%- endfor %}
                      </div>
                      {%- endif %}
                      {%- if count %}
                      <div class="entry-summary">{{ count }}</div>
                      {%- endif %}
                    </div>
                  </div>
                  {%- endif %}
                </div>
                {%- endfor %}
              </div>
              <span class="delta-term-meta">
                <span class="delta-change-label" data-change="{{ card.change }}">{{ card.change }}</span>
                {%- if card.delta.paired_by == 'rename-log' %}
                <span class="delta-badge" title="Paired by the rename log">mapped by hand</span>
                {%- endif %}
              </span>
            </div>
          </div>
          <div class="refs scenario-body" id="term-refs-{{ key }}" data-term-id="{{ key }}" :class="{ expanded: expandedTerms[$el.dataset.termId] }">
            <div class="refs-inner scenario-body-inner">
              <div class="refs-content">
                {#- Always, so opening the card answers even when none of the
                    term's scenarios changed: its count includes them. -#}
                <div class="refs-line">
                  <span class="refs-label">Listed scenarios:</span>
                  {% for item in card.scenarios %}
                  <a class="use-chip delta-scenario-chip" href="#{{ item.fragment }}" data-goto-scenario="{{ item.slug }}" data-change="{{ item.change }}" title="{{ item.change | capitalize }} scenario">{{ change_glyph[item.change] }} {{ item.title_text }}</a>
                  {% else %}
                  <span class="delta-refs-none">none</span>
                  {% endfor %}
                </div>
                {% if term.source %}
                <div class="scenario-source">{{ source_link(term.source, card.side) }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
  {%- endmacro -%}

  {#- The hairline between the two columns, in a track of its own. -#}
  {%- macro delta_rule() -%}
        <div class="delta-rule" aria-hidden="true"></div>
  {%- endmacro -%}

  {#- A listed scenario's sides in two columns, before on the left: a
      changed scenario's steps side by side above its tables, an added or
      removed one's own side alone, in one column from the left, since its
      change says which side it is. A table that didn't change spans both
      columns. `data-side` scopes a hovered row's preview to
      its own side's text. -#}
  {%- macro delta_sides(item, scenario_idx) -%}
      {%- set scenario = item.shown -%}
      {%- set steps = item.steps -%}
      {%- set table = item.table -%}
      {%- set sides = ['before', 'after'] if steps is not none else [item.side] -%}
      <div class="delta-sides{% if steps is none %} delta-one-side{% endif %}">
        {%- if steps is not none %}{{ delta_rule() }}{% endif %}
        {%- for side in sides %}
        <div class="delta-side-steps" data-side="{{ side }}">
          {%- if steps is not none %}{{ delta_steps(steps, side, scenario_idx) }}{% else %}{{ scenario_steps(scenario, scenario_idx, side) }}{% endif -%}
        </div>
        {%- endfor %}
        {%- if table %}
        {{ param_table_delta(table, scenario_idx) }}
        {%- elif scenario.parameters %}
        <div class="{{ 'delta-shared' if steps is not none else 'delta-table' }}"{% if steps is none %} data-side="{{ item.side }}"{% endif %}>
          {{ param_table(scenario, scenario_idx) }}
        </div>
        {%- endif %}
      </div>
  {%- endmacro -%}

  {#- A changed scenario's steps on one side, under that side's phases, a row
      for each aligned pair of steps with a hatched one where the side lacks
      the step, outside any phase. A row's ID is its place among the rows,
      the same on both sides: it keys the row's line for `delta.js` to align,
      and its open sub-steps, so one toggle opens both sides. -#}
  {%- macro delta_steps(view, side, scenario_idx) -%}
      <div class="steps">
        {%- for block in view.side(side) -%}
          {%- if block.phase is none -%}
          <div class="delta-gaps">
            {%- for row in block.rows %}{{ step_gap('s' ~ scenario_idx ~ '_' ~ row.path | join('_')) }}{% endfor -%}
          </div>
          {%- else -%}
          <div class="phase-block{% if block.continued %} delta-continued{% endif %}" data-block="{{ block.key }}">
            {%- if not block.continued %}<div class="phase-label">{{ block.phase | capitalize }}</div>{% endif -%}
            {%- for row in block.rows -%}
            <div class="phase-steps">
              {{ render_step_row(row, side, 's' ~ scenario_idx ~ '_' ~ row.path | join('_')) }}
            </div>
            {%- endfor -%}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
  {%- endmacro -%}

  {%- macro step_gap(step_id) -%}
    <div class="delta-gap" data-row="{{ step_id }}" aria-hidden="true"></div>
  {%- endmacro -%}

  {#- An added or removed row is its step's whole subtree, rendered as one. -#}
  {%- macro render_step_row(row, side, step_id) -%}
    {%- set line = row.line(side) -%}
    <div class="delta-step" data-change="{{ row.change }}" data-row="{{ step_id }}">
    {%- if row.change in ('added', 'removed') -%}
      {{ render_step(line.step, step_id, side) }}
    {%- else -%}
      {{ step_text(line.step, step_id, line.words | narration_diff(side) if line.words else line.step.narration | narration(side)) }}
      {%- if row.children -%}
        {%- call step_children(step_id) -%}
          {%- for child in row.children -%}
            {%- set child_id = step_id ~ '_' ~ loop.index0 -%}
            {%- if child.line(side) is none %}{{ step_gap(child_id) }}{% else %}{{ render_step_row(child, side, child_id) }}{% endif -%}
          {%- endfor -%}
        {%- endcall -%}
      {%- endif -%}
      {% if line.step.attachments %}{{ step_attachments(line.step, step_id) }}{% endif %}
    {%- endif -%}
    </div>
  {%- endmacro -%}

  {#- A changed parameter table: each side's table whole, in its side's
      column, the rows lined up by case with a hatched row where a side lacks
      one. A band, the header or a case with the rows under it, is what
      `delta.js` evens out across the two tables. -#}
  {%- macro param_table_delta(view, scenario_idx) -%}
        {%- for table in view.sides %}
        {%- set after = table.side == 'after' %}
        {%- set col_blocks = table.column_blocks %}
        {%- set table_width = table.columns | length + 2 %}
        {#- The mark a changed cell takes on this side: the old value faces
            the new one. -#}
        {%- set cell_mark = 'added' if after else 'removed' %}
        <div class="delta-table" data-side="{{ table.side }}">
          <div class="param-table-scroll">
          <table class="param-table">
            <thead data-band="head">
              <tr>
                <th class="param-id" data-block="frame">case ID</th>
                {%- for column in table.columns %}
                {%- set col = column.column %}
                <th data-param="{{ col.id }}"{% if col.id in col_blocks %} data-block="{{ col_blocks[col.id] }}"{% endif %}{% if column.change %} data-change="{{ column.change }}"{% endif %}>
                  {%- if column.change == 'removed' %}<del>{{ col.name }}</del>
                  {%- elif column.change == 'added' %}+{{ col.name }}
                  {%- else %}{{ col.name }}{% endif %}
                  {%- if column.was %}<span class="delta-was">was <del>{{ column.was }}</del></span>{% endif -%}
                </th>
                {%- endfor %}
                <th class="param-status" data-block="frame">status</th>
              </tr>
            </thead>
            {%- for row in view.rows %}
            {%- set case = row.case(table.side) %}
            {%- set cell_prefix = 's' ~ scenario_idx ~ '_' ~ table.side ~ '_case' ~ loop.index0 ~ '_col' %}
            <tbody data-band="{{ loop.index0 }}">
              {%- if case %}
              <tr data-case-row{% if row.change in ('added', 'removed') %} data-change="{{ row.change }}"{% endif %}>
                <th scope="row" class="param-id" data-block="frame"{% if row.pair.id_changed %} data-change="{{ cell_mark }}"{% endif %}>
                  <span class="delta-row-lead">{{ change_glyph[row.change] if row.change else '' }}</span>
                  {%- if row.change == 'removed' %}<del>{{ case.id | case_id }}</del>{% else %}{{ case.id | case_id }}{% endif -%}
                </th>
                {%- for col, val in table.parameters.cells(case) %}
                {%- set changed = table.columns[loop.index0].change == 'added' or col.id in row.pair.changed_cells %}
                {%- set block, change = col_blocks.get(col.id), cell_mark if changed else none %}
                {% if col.kind == 'attachment' %}{{ attachment_cell(col, val, cell_prefix ~ loop.index0, block, change) }}{% else %}{{ col | value_cell(val, block, change) }}{% endif %}
                {%- endfor %}
                <td class="param-status" data-block="frame"{% if row.pair.status_changed %} data-change="{{ cell_mark }}"{% endif %}>{{ status_dot(case.status) }}</td>
              </tr>
              {% if case.error or 'attachment' in table.parameters.columns | map(attribute='kind') %}{{ case_extras(table.parameters, case, cell_prefix, table_width) }}{% endif %}
              {%- else %}
              <tr class="delta-placeholder-row" aria-hidden="true"><td colspan="{{ table_width }}"></td></tr>
              {%- endif %}
            </tbody>
            {%- endfor %}
          </table>
          </div>
        </div>
        {%- endfor %}
  {%- endmacro -%}
