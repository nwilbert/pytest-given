{#
  What the delta page adds to the report's macros: the Change and Changed in
  filters, a changed scenario's two sides (the report's phase blocks and
  step lines, each step's change marked on its side, styled as
  `.delta-step`, and the parameter tables), and a listed term's card.
#}
  {%- from '_macros.html.j2' import source_link, anchor_link, term_disclosure, render_step, step_text, step_children, scenario_steps, param_table, attachment_cell, attachment_icon, expandable_attachment, case_extras, case_error_row, attachment_panel_row, status_dot with context -%}

  {#- The Change filter's pills, each disabled at zero, and how many items
      matched with no change. `model` is the Alpine property the pills
      toggle: a name from the template, never report data. -#}
  {%- macro change_filter(model, counts, unchanged_count) -%}
    <div class="sidebar-section">
      <div class="sidebar-label">Change</div>
      <div class="status-pills">
        {%- for change, count in counts.items() %}
        <button type="button" class="btn-reset status-pill delta-change-pill" data-change="{{ change }}" :class="{ 'active-change': {{ model }}.{{ change }} }" :aria-pressed="{{ model }}.{{ change }}" @click="{{ model }}.{{ change }} = !{{ model }}.{{ change }}"{% if not count %} disabled{% endif %}>{{ change_glyph[change] }} {{ change | capitalize }} <span>{{ count }}</span></button>
        {%- endfor %}
      </div>
      <div class="delta-unchanged">{{ unchanged_count }} unchanged</div>
    </div>
  {%- endmacro -%}

  {#- The Changed in filter: a box per changed part, the report's kind
      filter rows in the changed colour, each disabled at zero, and the
      whole group while the Changed pill is off. -#}
  {%- macro changed_in_filter(counts) -%}
    <fieldset class="delta-changed-in" :disabled="!shownChanges.changed">
      <legend class="sidebar-label">Changed in</legend>
      {%- for part, count in counts.items() %}
      <label class="kind-filter-row{% if not count %} delta-part-empty{% endif %}">
        <input type="checkbox" x-model="shownParts.{{ part }}"{% if not count %} disabled{% endif %}>
        <span class="kind-swatch"></span>
        <span>{{ part | capitalize }}</span>
        <span class="nav-group-count">{{ count }}</span>
      </label>
      {%- endfor %}
    </fieldset>
  {%- endmacro -%}

  {#- A listed term's card, a row as the report's Glossary entry is: its
      name (a renamed term's old one under it), a changed term's two
      definitions side by side or an added or removed one's own, and its
      change; its bar its change too. Opening it shows each side's other
      forms and scenario count, in that side's column, then links the listed
      scenarios that refer to it, each into the Scenarios tab
      (`data-goto-scenario`). -#}
  {%- macro term_card(card) -%}
        {%- set term = card.shown %}
        {%- set key = card.key %}
        <div class="entry" id="term-{{ key }}" data-term-id="{{ key }}" data-change="{{ card.change }}"
             x-show="termShown($el.dataset.termId)">
          <div class="entry-head" data-term-id="{{ key }}" @click="toggleTerm($el.dataset.termId)">
            {{ term_disclosure(key) }}
            <span class="entry-name delta-title">
              <span class="term-name">{% if card.change == 'removed' %}<del>{{ term.canonical }}</del>{% else %}{{ term.canonical }}{% endif %}{{ anchor_link('view=glossary&term=' ~ key) }}</span>
              {%- if card.renamed_from %}
              <span class="delta-was">was <del>{{ card.renamed_from }}</del></span>
              {%- endif %}
            </span>
            <div class="entry-body">
              <div class="delta-sides{% if card.sides | length == 1 %} delta-one-side{% endif %}">
                {%- if card.sides | length == 2 %}{{ delta_rule() }}{% endif %}
                {%- for side in card.sides %}
                {%- set version = card.term(side) %}
                {%- set words = card.definition(side) %}
                {%- set forms = card.other_forms(side) %}
                {%- set count = card.scenario_count(side) %}
                <div class="delta-term-side" data-side="{{ side }}">
                  <div class="entry-def">
                    {%- if words %}{{ words | definition_diff }}{% else %}{{ version.definition_text | inline_md }}{% endif -%}
                    {%- if version.definition is none %}<span class="entry-def-badge">Undefined</span>{% endif -%}
                  </div>
                  {%- if forms or count %}
                  <div class="delta-term-more" data-term-id="{{ key }}" :class="{ expanded: expandedTerms[$el.dataset.termId] }">
                    <div class="delta-term-more-inner">
                      {%- if forms %}
                      <div class="delta-term-forms">
                        {%- for form in forms %}
                        {%- if form.change == 'removed' %}
                        <del class="use-chip use-chip--static delta-form" data-change="removed" title="Removed form">{{ form.text }}</del>
                        {%- elif form.change == 'added' %}
                        <span class="use-chip use-chip--static delta-form" data-change="added" title="Added form">{{ change_glyph['added'] }}{{ form.text }}</span>
                        {%- else %}
                        <span class="use-chip use-chip--static">{{ form.text }}</span>
                        {%- endif %}
                        {%- endfor %}
                      </div>
                      {%- endif %}
                      {%- if count %}
                      <div class="entry-summary">{{ count }}</div>
                      {%- endif %}
                    </div>
                  </div>
                  {%- endif %}
                </div>
                {%- endfor %}
              </div>
              <span class="delta-term-meta">
                <span class="delta-change-label" data-change="{{ card.change }}">{{ card.change }}</span>
                {%- if card.delta.paired_by == 'rename-log' %}
                <span class="delta-badge" title="Paired by the rename log">mapped by hand</span>
                {%- endif %}
              </span>
            </div>
          </div>
          <div class="refs scenario-body" id="term-refs-{{ key }}" data-term-id="{{ key }}" :class="{ expanded: expandedTerms[$el.dataset.termId] }">
            <div class="refs-inner scenario-body-inner">
              <div class="refs-content">
                {#- Always, so opening the card answers even when none of the
                    term's scenarios changed: its count includes them. -#}
                <div class="refs-line">
                  <span class="refs-label">Listed scenarios:</span>
                  {% for item in card.scenarios %}
                  <a class="use-chip delta-scenario-chip" href="#{{ item.fragment }}" data-goto-scenario="{{ item.slug }}" data-change="{{ item.change }}" title="{{ item.change | capitalize }} scenario">{{ change_glyph[item.change] }} {{ item.title_text }}</a>
                  {% else %}
                  <span class="delta-refs-none">none</span>
                  {% endfor %}
                </div>
                {% if term.source %}
                <div class="scenario-source">{{ source_link(term.source, card.side) }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
  {%- endmacro -%}

  {#- The hairline between the two columns, in a track of its own. -#}
  {%- macro delta_rule() -%}
        <div class="delta-rule" aria-hidden="true"></div>
  {%- endmacro -%}

  {#- A listed scenario's sides in two columns, before on the left: a
      changed scenario's steps side by side above its tables, an added or
      removed one's own side alone, in one column from the left, since its
      change says which side it is. A table that didn't change spans both
      columns. `data-side` scopes a hovered row's preview to
      its own side's text. -#}
  {%- macro delta_sides(item, scenario_idx) -%}
      {%- set scenario = item.shown -%}
      {%- set steps = item.steps -%}
      {%- set table = item.table -%}
      {%- set sides = ['before', 'after'] if steps is not none else [item.side] -%}
      <div class="delta-sides{% if steps is none %} delta-one-side{% endif %}">
        {%- if steps is not none %}{{ delta_rule() }}{% endif %}
        {%- for side in sides %}
        <div class="delta-side-steps" data-side="{{ side }}">
          {%- if steps is not none %}{{ delta_steps(steps, side, scenario_idx) }}{% else %}{{ scenario_steps(scenario, scenario_idx, side) }}{% endif -%}
        </div>
        {%- endfor %}
        {%- if table %}
        {{ param_table_delta(table, scenario_idx) }}
        {%- elif scenario.parameters %}
        <div class="{{ 'delta-shared' if steps is not none else 'delta-table' }}"{% if steps is none %} data-side="{{ item.side }}"{% endif %}>
          {{ param_table(scenario, scenario_idx) }}
        </div>
        {%- endif %}
      </div>
  {%- endmacro -%}

  {#- A changed scenario's steps on one side, under that side's phases, a row
      for each aligned pair of steps with a hatched one where the side lacks
      the step, outside any phase. A row's ID is its place among the rows,
      the same on both sides: it keys the row's line for `delta.js` to align,
      and its open sub-steps, so one toggle opens both sides. -#}
  {%- macro delta_steps(view, side, scenario_idx) -%}
      <div class="steps">
        {%- for block in view.side(side) -%}
          {%- if block.phase is none -%}
          <div class="delta-gaps">
            {%- for row in block.rows %}{{ step_gap(row.row_id(scenario_idx)) }}{% endfor -%}
          </div>
          {%- else -%}
          <div class="phase-block{% if block.continued %} delta-continued{% endif %}" data-block="{{ block.key }}">
            {%- if not block.continued %}<div class="phase-label">{{ block.phase | capitalize }}</div>{% endif -%}
            {%- for row in block.rows -%}
            <div class="phase-steps">
              {{ render_step_row(row, side, scenario_idx) }}
            </div>
            {%- endfor -%}
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
  {%- endmacro -%}

  {%- macro step_gap(step_id) -%}
    <div class="delta-gap" data-row="{{ step_id }}" aria-hidden="true"></div>
  {%- endmacro -%}

  {#- An added, removed or replaced row is its step's whole subtree on each
      side, rendered as one. -#}
  {%- macro render_step_row(row, side, scenario_idx) -%}
    {%- set line = row.line(side) -%}
    {%- set step_id = row.row_id(scenario_idx) -%}
    {%- set change = row.change_on(side) -%}
    <div class="delta-step" data-change="{{ change }}" data-row="{{ step_id }}">
    {%- if change in ('added', 'removed') -%}
      {{ render_step(line.step, step_id, side) }}
    {%- else -%}
      {{ step_text(line.step, step_id, line.words | narration_diff(side) if line.words else line.step.narration | narration(side)) }}
      {%- if row.children -%}
        {%- call step_children(step_id) -%}
          {%- for child in row.children -%}
            {%- if child.line(side) is none %}{{ step_gap(child.row_id(scenario_idx)) }}{% else %}{{ render_step_row(child, side, scenario_idx) }}{% endif -%}
          {%- endfor -%}
        {%- endcall -%}
      {%- endif -%}
      {% if row.attachments %}{{ delta_attachments(row, side, step_id) }}{% endif %}
    {%- endif -%}
    </div>
  {%- endmacro -%}

  {#- A paired step's attachments, a row each with a hatched one where the
      side lacks it, for `delta.js` to line up as it does steps. An
      attachment's key, the same on both sides, opens it on both. -#}
  {%- macro delta_attachments(row, side, step_id) -%}
    <div class="step-attachments">
    {%- for attachment_row in row.attachments -%}
    {%- set key = step_id ~ '_att_' ~ loop.index0 -%}
    {%- set att = attachment_row.attachment(side) -%}
    {%- set change = attachment_row.change if attachment_row.change != 'equal' else none -%}
    {%- if att is none -%}
    {{ step_gap(key) }}
    {%- elif att is attachment_ref -%}
    <div data-row="{{ key }}">
      <span class="attachment-badge attachment-badge--static" data-param="{{ att.column_id }}"{% if change %} data-change="{{ change }}"{% endif %}>{{ badge_lead(change) }}{{ attachment_icon(att.content_type) }}{{ badge_label(att, change) }}</span>
    </div>
    {%- elif attachment_row.rows -%}
    <div data-row="{{ key }}">
      {% call expandable_attachment(key, badge_label(att, change), att.content, att.content_type, change, badge_lead(change)) %}{{ diff_panel(attachment_row.rows, side, key) }}{% endcall %}
    </div>
    {%- else -%}
    <div data-row="{{ key }}">
      {{ expandable_attachment(key, badge_label(att, change), att.content, att.content_type, change, badge_lead(change)) }}
    </div>
    {%- endif -%}
    {%- endfor -%}
    </div>
  {%- endmacro -%}

  {#- A changed attachment's glyph, which leads its badge's icon. -#}
  {%- macro badge_lead(change) -%}
    {%- if change %}<span class="delta-badge-lead">{{ change_glyph[change] }}</span>{% endif -%}
  {%- endmacro -%}

  {%- macro badge_label(att, change) -%}
    {%- if change == 'removed' %}<del>{{ att.label }}</del>{% else %}{{ att.label }}{% endif -%}
  {%- endmacro -%}

  {#- A changed payload's line diff on one side: a line per row, unwrapped, a
      hatched one where the side lacks the line, so the two sides' lines stay
      level by themselves. A fold's key is shared too, so it opens on both.
      `data-scroll-pair` names the panel the other side scrolls along. -#}
  {%- macro diff_panel(rows, side, key) -%}
    <div class="attachment-content delta-diff" data-scroll-pair="{{ key }}">
      <div class="delta-diff-lines">
      {%- for diff_row in rows -%}
        {%- if diff_row is fold_row -%}
        {%- set fold_key = key ~ '_fold' ~ loop.index0 %}
        <div class="delta-fold" :class="{ expanded: expandedAttachments['{{ fold_key }}'] }">
          <button type="button" class="btn-reset delta-fold-toggle"
                  :aria-expanded="!!expandedAttachments['{{ fold_key }}']"
                  @click="toggleAttachment('{{ fold_key }}')"><span>&hellip; {{ diff_row.rows | length }} unchanged lines</span></button>
          <div class="delta-fold-lines">
            {%- for line in diff_row.rows %}{{ diff_line(line, side) }}{% endfor -%}
          </div>
        </div>
        {%- else -%}
        {{ diff_line(diff_row, side) }}
        {%- endif -%}
      {%- endfor -%}
      </div>
    </div>
  {%- endmacro -%}

  {%- macro diff_line(line, side) -%}
    {%- set text = line.before if side == 'before' else line.after -%}
    {%- if text is none -%}
    <div class="delta-line-gap" aria-hidden="true"></div>
    {%- else -%}
    <div class="delta-line"{% if line.change != 'equal' %} data-change="{{ line.change }}"{% endif %}>
      {%- if line.words %}{{ line.words | text_diff(side) }}{% else %}{{ text }}{% endif -%}
    </div>
    {%- endif -%}
  {%- endmacro -%}

  {#- A changed parameter table: each side's table whole, in its side's
      column, the rows lined up by case with a hatched row where a side lacks
      one. A band, the header or a case with the rows under it (its changed
      attachment cells' rows a band of their own), is what `delta.js` evens
      out across the two tables. -#}
  {%- macro param_table_delta(view, scenario_idx) -%}
        {%- for table in view.sides %}
        {%- set col_blocks = table.column_blocks %}
        {%- set table_width = table.columns | length + 2 %}
        {%- set has_attachments = 'attachment' in table.parameters.columns | map(attribute='kind') %}
        <div class="delta-table" data-side="{{ table.side }}">
          <div class="param-table-scroll">
          <table class="param-table">
            <thead data-band="head">
              <tr>
                <th class="param-id" data-block="frame">case ID</th>
                {%- for column in table.columns %}
                {%- set col = column.column %}
                <th data-param="{{ col.id }}"{% if col.id in col_blocks %} data-block="{{ col_blocks[col.id] }}"{% endif %}{% if column.change %} data-change="{{ column.change }}"{% endif %}>
                  {%- if column.change == 'removed' %}<del>{{ col.name }}</del>
                  {%- elif column.change == 'added' %}{{ change_glyph['added'] }}{{ col.name }}
                  {%- else %}{{ col.name }}{% endif %}
                  {%- if column.was %}<span class="delta-was">was <del>{{ column.was }}</del></span>{% endif -%}
                </th>
                {%- endfor %}
                <th class="param-status" data-block="frame">status</th>
              </tr>
            </thead>
            {%- for row in view.rows %}
            {%- set case = row.case(table.side) %}
            {%- set cell_prefix = 's' ~ scenario_idx ~ '_' ~ table.side ~ '_case' ~ loop.index0 ~ '_col' %}
            {#- A changed attachment cell's key leaves out the side, so it opens
                on both: its place among the row's diffs, alike on both sides,
                never the column ID, which is report data. -#}
            {%- set diff_prefix = 's' ~ scenario_idx ~ '_case' ~ loop.index0 ~ '_diff' %}
            {%- set diff_columns = row.attachment_diffs | list %}
            <tbody data-band="{{ loop.index0 }}">
              {%- if case %}
              <tr data-case-row{% if row.change in ('added', 'removed') %} data-change="{{ row.change }}"{% endif %}>
                <th scope="row" class="param-id" data-block="frame"{% if row.pair.id_changed %} data-change="{{ table.mark }}"{% endif %}>
                  <span class="delta-row-lead">{{ change_glyph[row.change] if row.change else '' }}</span>
                  {%- if row.change == 'removed' %}<del>{{ case.id | case_id }}</del>{% else %}{{ case.id | case_id }}{% endif -%}
                </th>
                {%- for col, val, block, change in table.cells(case, row.pair) %}
                {% if col.kind == 'attachment' %}{{ attachment_cell(col, val, diff_prefix ~ diff_columns.index(col.id) if col.id in diff_columns else cell_prefix ~ loop.index0, block, change) }}{% else %}{{ col | value_cell(val, block, change, col.id in table.repr_columns) }}{% endif %}
                {%- endfor %}
                <td class="param-status" data-block="frame"{% if row.pair.status_changed %} data-change="{{ table.mark }}"{% endif %}>{{ status_dot(case.status) }}</td>
              </tr>
              {% if not diff_columns and (case.error or has_attachments) %}{{ case_extras(table.parameters, case, cell_prefix, table_width) }}{% endif %}
              {%- else %}
              <tr class="delta-placeholder-row" aria-hidden="true"><td colspan="{{ table_width }}"></td></tr>
              {%- endif %}
            </tbody>
            {%- if diff_columns %}
            <tbody data-band="{{ loop.index0 }}-diff">
              {{ delta_case_extras(table, case, row, diff_columns, cell_prefix, diff_prefix, table_width) }}
            </tbody>
            {%- endif %}
            {%- endfor %}
          </table>
          </div>
        </div>
        {%- endfor %}
  {%- endmacro -%}

  {#- A case's rows under it when an attachment cell of it changed, in a band
      of their own, so the case row above them is evened out first: the
      changed cells' diffs, which both sides have, keyed as their badges are,
      then the rows only one side may have, its error and its other
      payloads. A diff shows on a side whose cell is empty too, all hatched.
      A cell changed in content type alone has no lines to diff, so it shows
      its payload. -#}
  {%- macro delta_case_extras(table, case, row, diff_columns, cell_prefix, diff_prefix, table_width) -%}
          {%- for column_id in diff_columns %}
          {%- set col = table.parameters.columns | selectattr('id', 'equalto', column_id) | first %}
          {%- set key = diff_prefix ~ loop.index0 %}
          {%- set diff = row.attachment_diffs[column_id] %}
          {% call attachment_panel_row(key, col.name, table_width) %}
          {%- if diff %}{{ diff_panel(diff, table.side, key) }}
          {%- else %}{% for cell_col, val in table.parameters.cells(case) if cell_col.id == column_id %}<div class="attachment-content"><pre>{{ val.content }}</pre></div>{% endfor %}{% endif -%}
          {% endcall %}
          {%- endfor %}
          {% if case.error %}{{ case_error_row(case, table_width) }}{% endif %}
          {%- for col, val in table.parameters.cells(case) %}
          {%- if col.kind == 'attachment' and val and col.id not in diff_columns %}
          {% call attachment_panel_row(cell_prefix ~ loop.index0, col.name, table_width) %}<div class="attachment-content"><pre>{{ val.content }}</pre></div>{% endcall %}
          {%- endif %}
          {%- endfor %}
  {%- endmacro -%}
