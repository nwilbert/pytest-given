{%- macro node_icon(placed) %}
<g transform="translate({{ placed.x | round }},{{ placed.y | round }})"
   @mouseenter='showTip($event, {{ placed.node.label | tojson }}, {{ (placed.node.term_id or "") | tojson }})'
   @mouseleave="tooltip = null">
  {# Invisible hit-area: the actor stick figure is drawn with fill:none (only
     its ~2px stroke would otherwise catch hover), so without this a user
     pointing at the icon's centre -- the natural target -- gets nothing. #}
  <rect x="-40" y="-40" width="80" height="110" class="hit-area"/>
  {% if placed.node.glyph == 'actor' %}
  <circle cx="0" cy="-16" r="9" class="glyph"/>
  <path d="M 0 -7 L 0 12 M -14 2 L 14 2 M 0 12 L -11 30 M 0 12 L 11 30" class="glyph"/>
  {% else %}
  <path d="M -16 -22 L 8 -22 L 16 -14 L 16 22 L -16 22 Z" class="glyph doc"/>
  <path d="M 8 -22 L 8 -14 L 16 -14" class="glyph"/>
  {% endif %}
  {% set lines = placed.node.label | label_lines %}
  <text x="0" y="50" class="label">
    {%- for line in lines %}<tspan x="0" dy="{{ 0 if loop.first else 15 }}">{{ line }}</tspan>{% endfor -%}
  </text>
  {% if placed.node.sublabel %}<text x="0" y="{{ 66 + (lines | length - 1) * 15 }}" class="sublabel">{{ placed.node.sublabel }}</text>{% endif %}
</g>
{% endmacro -%}

{%- macro edge_label(placed) %}
{% set cx = placed.label.x %}
{% set cy = placed.label.y + placed.label.height - 6 %}
{% if placed.edge.number is not none %}
<circle cx="{{ (cx + 11) | round }}" cy="{{ (cy - 5) | round }}" r="11" class="numbg"/>
<text x="{{ (cx + 11) | round }}" y="{{ (cy - 1) | round }}" class="num">{{ placed.edge.number }}</text>
<text x="{{ (cx + 27) | round }}" y="{{ (cy - 1) | round }}" class="verb{{ ' conn' if placed.edge.connective }}">{{ placed.edge.label }}</text>
{% else %}
<text x="{{ cx | round }}" y="{{ (cy - 1) | round }}"
      class="verb {{ 'conn' if placed.edge.connective }}">{{ placed.edge.label }}</text>
{% endif %}
{% endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ metadata.project }} — story diagrams</title>
<style>{{ css }}</style>
</head>
<body x-data="diagramsApp()" x-cloak>
<header class="topbar">
  <span class="project">{{ metadata.project }}</span> · story diagrams
</header>
{% if not views %}
<div class="no-stories">
  <p>No stories were recorded for this run.</p>
  <p class="no-stories-hint">Wrap steps in <code>story(...)</code> to see them here.</p>
</div>
{% else %}
<div class="layout">
  <nav class="sidebar">
    {% for view in views %}
    {% set story = view.layout.graph %}
    <div class="story-item" :class="{ active: selectedStory === '{{ story.story_id }}' }"
         @click="selectedStory = '{{ story.story_id }}'">
      <div class="story-title">{{ story.title }}</div>
      <div class="story-meta">{{ view.activity_count }} activities</div>
    </div>
    {% endfor %}
  </nav>
  <main>
    {% for view in views %}
    {% set story = view.layout.graph %}
    <section id="{{ story.story_id }}" x-show="selectedStory === '{{ story.story_id }}'">
      <div class="story-header">
        <h1>{{ story.title }}</h1>
        {% if view.max_step > 0 %}
        <div class="replay">
          <button @click="prevStep()" :disabled="step === null">‹</button>
          <span x-text="step === null ? 'all' : 'step ' + step + ' / ' + maxSteps['{{ story.story_id }}']"></span>
          <button @click="nextStep()" :disabled="step === maxSteps['{{ story.story_id }}']">›</button>
        </div>
        {% endif %}
      </div>
      {% if view.max_step == 0 %}
      <p class="empty-note">This story has no activities yet.</p>
      {% else %}
      <div class="zoom-bar">
        <button @click="zoomOut()" title="Zoom out">−</button>
        <button @click="zoomIn()" title="Zoom in">+</button>
        <button @click="fitDiagram()" title="Fit to view">Fit</button>
        <button @click="resetZoom()" title="Reset to 100%">100%</button>
        <span class="zoom-level" x-text="Math.round(zoom * 100) + '%'"></span>
      </div>
      <div class="canvas" x-ref="canvas_{{ story.story_id }}" @wheel.prevent="onWheel($event)">
        <div class="zoom-surface" :style="surfaceStyle()">
      <svg width="{{ view.layout.width | round | int }}" height="{{ view.layout.height | round | int }}"
           viewBox="0 0 {{ view.layout.width | round | int }} {{ view.layout.height | round | int }}">
        <defs>
          {# marker id keyed by story id: inner loops rebind `loop`, and ids
             must be unique across the page's per-story SVGs #}
          <marker id="arrow-{{ story.story_id }}" viewBox="0 0 10 10" refX="9" refY="5"
                  markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" class="arrowhead"/>
          </marker>
        </defs>
        {# per-activity groups: edges + this activity's work-object nodes #}
        {% for activity in view.layout.graph.edges | map(attribute='activity_id') | unique %}
        <g class="activity"
           :class="{ faded: faded({{ activity }}), dimmed: hoverActivity !== null && hoverActivity !== {{ activity }} }"
           @mouseenter="hoverActivity = {{ activity }}" @mouseleave="hoverActivity = null">
          {% for placed in view.layout.edges if placed.edge.activity_id == activity %}
          {% if placed.loop %}
          {% set loop_d %}M {{ (placed.x1 - 18) | round }} {{ (placed.y1 - 40) | round }}
                   A 46 46 0 1 1 {{ (placed.x1 + 18) | round }} {{ (placed.y1 - 40) | round }}{% endset %}
          {# Invisible wide-stroke twin: a 1.6px line is a hard target for a
             real pointer, so hovering to dim other activities needs a fatter
             (but invisible) hit-strip along the same path. #}
          <path class="edge-hit" d="{{ loop_d }}"/>
          <path class="edge {{ 'connective' if placed.edge.connective }}"
                marker-end="url(#arrow-{{ story.story_id }})" d="{{ loop_d }}"/>
          {% else %}
          <line class="edge-hit"
                x1="{{ placed.x1 | round }}" y1="{{ placed.y1 | round }}"
                x2="{{ placed.x2 | round }}" y2="{{ placed.y2 | round }}"/>
          <line class="edge {{ 'connective' if placed.edge.connective }}"
                x1="{{ placed.x1 | round }}" y1="{{ placed.y1 | round }}"
                x2="{{ placed.x2 | round }}" y2="{{ placed.y2 | round }}"
                marker-end="url(#arrow-{{ story.story_id }})"/>
          {% endif %}
          {{ edge_label(placed) }}
          {% endfor %}
          {% for placed in view.layout.nodes if placed.node.glyph == 'work'
                and placed.node.id.startswith('work:' ~ activity ~ ':') %}
          {{ node_icon(placed) }}
          {% endfor %}
        </g>
        {% endfor %}
        {# actors last: always visible, on top #}
        <g class="actors">
          {% for placed in view.layout.nodes if placed.node.glyph == 'actor' %}
          {{ node_icon(placed) }}
          {% endfor %}
        </g>
      </svg>
        </div>
      </div>
      {% endif %}
    </section>
    {% endfor %}
  </main>
</div>
{% endif %}
<div class="tooltip" x-show="tooltip !== null" x-cloak
     :style="tooltip && ('left:' + (tooltip.x + 14) + 'px; top:' + (tooltip.y + 14) + 'px')">
  <template x-if="tooltip">
    <div>
      <div class="tooltip-title" x-text="tooltip.title"></div>
      <div class="tooltip-kind" x-text="tooltip.kind || 'unclassified'"></div>
      <div class="tooltip-def" x-text="tooltip.definition || 'No definition yet.'"></div>
    </div>
  </template>
</div>
<script>
const STORY_IDS = {{ story_ids_json }};
const MAX_STEPS = {{ max_steps_json }};
const DIAGRAM_SIZES = {{ diagram_sizes_json }};
const TERM_INFO = {{ term_info_json }};
function diagramsApp() {
  return {
    selectedStory: null, step: null, hoverActivity: null, tooltip: null,
    zoom: 1, panX: 0, panY: 0,
    maxSteps: MAX_STEPS,
    init() {
      let hash;
      try { hash = decodeURIComponent(location.hash.slice(1)); } catch { hash = ''; }
      this.selectedStory = STORY_IDS.includes(hash) ? hash : STORY_IDS[0];
      this.$watch('selectedStory', (id) => {
        history.replaceState(null, '', '#' + encodeURIComponent(id));
        this.step = null; this.hoverActivity = null;
        this.$nextTick(() => this.fitDiagram());
      });
      window.addEventListener('hashchange', () => {
        let next;
        try { next = decodeURIComponent(location.hash.slice(1)); } catch { next = ''; }
        if (STORY_IDS.includes(next)) this.selectedStory = next;
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') this.nextStep();
        if (e.key === 'ArrowLeft') this.prevStep();
      });
      this.$nextTick(() => this.fitDiagram());
    },
    nextStep() {
      const max = this.maxSteps[this.selectedStory];
      if (max > 0) this.step = this.step === null ? 1 : Math.min(this.step + 1, max);
    },
    prevStep() {
      if (this.step !== null) this.step = this.step <= 1 ? null : this.step - 1;
    },
    surfaceStyle() {
      return 'transform: translate(' + this.panX + 'px,' + this.panY +
             'px) scale(' + this.zoom + '); transform-origin: 0 0;';
    },
    _canvasEl() { return this.$refs['canvas_' + this.selectedStory]; },
    _setZoom(next, cx, cy) {
      // Zoom toward (cx, cy) in canvas-viewport coordinates: keep that point
      // fixed by adjusting the pan.
      next = Math.min(4, Math.max(0.1, next));
      const ratio = next / this.zoom;
      this.panX = cx - (cx - this.panX) * ratio;
      this.panY = cy - (cy - this.panY) * ratio;
      this.zoom = next;
    },
    _viewportCenter() {
      const el = this._canvasEl();
      return el ? [el.clientWidth / 2, el.clientHeight / 2] : [0, 0];
    },
    zoomIn() { const [cx, cy] = this._viewportCenter(); this._setZoom(this.zoom * 1.2, cx, cy); },
    zoomOut() { const [cx, cy] = this._viewportCenter(); this._setZoom(this.zoom / 1.2, cx, cy); },
    resetZoom() { this.zoom = 1; this.panX = 0; this.panY = 0; },
    fitDiagram() {
      const el = this._canvasEl();
      const size = DIAGRAM_SIZES[this.selectedStory];
      if (!el || !size) { this.resetZoom(); return; }
      const [w, h] = size;
      const scale = Math.min(el.clientWidth / w, el.clientHeight / h, 1) * 0.95;
      this.zoom = scale;
      this.panX = (el.clientWidth - w * scale) / 2;
      this.panY = (el.clientHeight - h * scale) / 2;
    },
    onWheel(event) {
      const el = this._canvasEl();
      const rect = el.getBoundingClientRect();
      const cx = event.clientX - rect.left;
      const cy = event.clientY - rect.top;
      // Trackpad pinch and ctrl/cmd + wheel arrive as wheel events with
      // ctrlKey/metaKey set -> zoom toward the cursor. A plain two-finger
      // scroll (no modifier) pans.
      if (event.ctrlKey || event.metaKey) {
        const factor = Math.exp(-event.deltaY * 0.01);
        this._setZoom(this.zoom * factor, cx, cy);
      } else {
        this.panX -= event.deltaX;
        this.panY -= event.deltaY;
      }
    },
    faded(n) { return this.step !== null && n > this.step; },
    showTip(event, title, termId) {
      const info = TERM_INFO[termId] || {};
      this.tooltip = { x: event.clientX, y: event.clientY,
                       title: title, kind: info.kind, definition: info.definition };
    },
  };
}
</script>
<script>{{ alpine_js }}</script>
</body>
</html>
