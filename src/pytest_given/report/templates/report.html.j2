<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ metadata.project }} — pytest-given Report</title>
<style>
{{ css }}
</style>
</head>
<body x-data="reportApp()">

<div class="main">

  {%- macro source_link(source) -%}
    {%- if source -%}
      {%- set url = source | source_url -%}
      {%- if url -%}
      <a href="{{ url }}">{{ source.relpath }}:{{ source.line }}</a>
      {%- else -%}
      <span>{{ source.relpath }}:{{ source.line }}</span>
      {%- endif -%}
    {%- endif -%}
  {%- endmacro -%}

  {%- macro anchor_link(hash) -%}
    <button type="button" class="anchor-link" title="Copy link"
            data-anchor="{{ hash }}"
            @click.stop="copyAnchor($el.dataset.anchor, $event)" aria-label="Copy link"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></button>
  {%- endmacro -%}

  {%- macro render_error(error) -%}
    {%- set internal_count = error.frames | selectattr('is_internal') | list | length -%}
    <div class="error-block"{% if internal_count %} x-data="{ showInternal: false }"{% endif %}>
      <div class="error-message">{{ error.message }}</div>
      {%- if internal_count -%}
        <button class="error-toggle" type="button" @click="showInternal = !showInternal">
          <span x-show="!showInternal">Show {{ internal_count }} internal frame{{ '' if internal_count == 1 else 's' }}</span>
          <span x-show="showInternal" x-cloak>Hide internal frames</span>
        </button>
      {%- endif -%}
      {%- if error.frames -%}
        <div class="error-frames">
          {%- for f in error.frames -%}
            <div class="error-frame{% if f.is_internal %} error-frame-internal{% endif %}"
                 {%- if f.is_internal %} x-show="showInternal" x-cloak{% endif -%}>
              <div class="error-frame-loc">{{ f.path }}:{{ f.lineno }}: in {{ f.func }}</div>
              <pre class="error-frame-code">{{ f.code }}</pre>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if error.error_tail -%}<pre class="error-tail">{{ error.error_tail }}</pre>{%- endif -%}
    </div>
  {%- endmacro -%}

  {#- `step_id` is interpolated straight into the Alpine expressions below,
      which is only safe because every caller builds it from loop indices
      ('s0_1_2') and never from report data. Alpine compiles a directive's
      decoded attribute text as JS, so a value carrying a `'` would break out
      of the string literal — HTML-escaping does not stop that. Anything
      data-derived goes in a `data-*` attribute and is read via
      `$el.dataset.*`, as `data-tag` and `data-term-id` do. -#}
  {%- macro attachment_icon() -%}
    <svg class="attachment-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.44 11.05-9.19 9.19a6 6 0 1 1-8.49-8.49l8.57-8.57A4 4 0 1 1 17.98 8.83l-8.49 8.49a2 2 0 1 1-2.83-2.83l8.49-8.49"/></svg>
  {%- endmacro -%}

  {#- Badge plus the payload it expands, keyed on `cell_id`. The step tree and
      the case table both attach this way; only a promoted attachment differs,
      having no payload of its own to expand. -#}
  {#- A badge opens a payload, so it is operable: reachable by keyboard and
      announced as a control, not as decorated text. -#}
  {%- macro attachment_badge(cell_id, label) -%}
    <span class="attachment-badge" role="button" tabindex="0"
          :aria-expanded="expandedAttachments['{{ cell_id }}'] ? 'true' : 'false'"
          @click="toggleAttachment('{{ cell_id }}')"
          @keydown.enter.prevent="toggleAttachment('{{ cell_id }}')"
          @keydown.space.prevent="toggleAttachment('{{ cell_id }}')">{{ attachment_icon() }}{{ label }}</span>
  {%- endmacro -%}

  {%- macro expandable_attachment(cell_id, label, content) -%}
    {{ attachment_badge(cell_id, label) }}
    <div class="attachment-expand" :class="{ expanded: expandedAttachments['{{ cell_id }}'] }">
      <div class="attachment-expand-inner">
        <div class="attachment-content"><pre>{{ content }}</pre></div>
      </div>
    </div>
  {%- endmacro -%}

  {%- macro render_step(step, step_id) -%}
  <div class="step-text">
    {%- if step.children and step.children | length > 0 -%}
      <span class="step-toggle" @click="toggleStep('{{ step_id }}')">
        <span class="step-chevron" :class="{ 'step-chevron-open': expandedSteps['{{ step_id }}'] }"></span>
        {{ step.narration | narration }}
      </span>
    {%- else -%}
      {{ step.narration | narration }}
    {%- endif -%}
  </div>
  {%- if step.children and step.children | length > 0 -%}
    <div class="step-expand" :class="{ expanded: expandedSteps['{{ step_id }}'] }">
      <div class="step-children">
        {%- for child in step.children -%}
          {{ render_step(child, step_id ~ '_' ~ loop.index0) }}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
  {%- if step.attachments -%}
    {%- for att in step.attachments -%}
    {%- if att is attachment_ref -%}
    <div>
      <span class="attachment-badge" data-param="{{ att.column_id }}"
            @mouseenter="setHoverParam($el.dataset.param, $event.currentTarget)"
            @mouseleave="setHoverParam(null, $event.currentTarget)">{{ attachment_icon() }}{{ att.label }}</span>
    </div>
    {%- else -%}
    <div>
      {{ expandable_attachment(step_id ~ '_att_' ~ loop.index0, att.label, att.content) }}
    </div>
    {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if step.error -%}
    {{ render_error(step.error) }}
  {%- endif -%}
  {%- endmacro -%}

  <header class="topbar">
    <div class="topbar-title">{{ metadata.project }}</div>
    <div class="topbar-meta">pytest {{ metadata.pytest_version }} · pytest-given {{ metadata.plugin_version }} · <span x-text="formattedTimestamp"></span></div>
  </header>

  {% if tab_visibility.scenarios or tab_visibility.stories or tab_visibility.glossary %}
  {% set visible_count = (tab_visibility.scenarios|int) + (tab_visibility.stories|int) + (tab_visibility.glossary|int) %}
  {% if visible_count > 1 %}
  <nav class="frame-nav" role="tablist">
    <button class="nav-tab" role="tab"
            :class="{ 'nav-tab-active': mainView === 'scenarios' }"
            @click="mainView = 'scenarios'">Scenarios</button>
    {% if tab_visibility.stories %}
    <button class="nav-tab" role="tab"
            :class="{ 'nav-tab-active': mainView === 'stories' }"
            @click="mainView = 'stories'">Stories</button>
    {% endif %}
    {% if tab_visibility.glossary %}
    <button class="nav-tab" role="tab"
            :class="{ 'nav-tab-active': mainView === 'glossary' }"
            @click="mainView = 'glossary'">Glossary</button>
    {% endif %}
  </nav>
  {% endif %}
  {% endif %}

  <div id="view-scenarios" x-show="mainView === 'scenarios'">
  <div class="view-layout">
  <div class="sidebar">
    <label class="search-box">
      <svg class="search-box-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="text" placeholder="Search scenarios..." x-model="search">
      <button type="button" class="search-box-clear" @click="search = ''" x-show="search" aria-label="Clear search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </label>

    <div class="sidebar-section">
      <div class="sidebar-label">Status</div>
      <div class="status-pills">
        <span class="status-pill" :class="{ 'active-passed': showPassed }" @click="showPassed = !showPassed">✓ Passed <span x-text="counts.passed"></span></span>
        <span class="status-pill" :class="{ 'active-failed': showFailed }" @click="showFailed = !showFailed">✗ Failed <span x-text="counts.failed"></span></span>
        <span class="status-pill" :class="{ 'active-skipped': showSkipped }" @click="showSkipped = !showSkipped" x-show="counts.skipped > 0">○ Skipped <span x-text="counts.skipped"></span></span>
      </div>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-label">Browse by</div>
      <div class="seg-toggle">
        <div class="seg-btn" :class="{ active: view === 'tags' }" @click="view = 'tags'">Tags</div>
        {#- The Terms axis needs a glossary to browse; without one the segment
            is omitted and app.js falls back to opening on Tags. -#}
        {% if tab_visibility.glossary %}
        <div class="seg-btn" :class="{ active: view === 'terms' }" @click="view = 'terms'">Terms</div>
        {% endif %}
        <div class="seg-btn" :class="{ active: view === 'modules' }" @click="view = 'modules'">Modules</div>
      </div>
      <div class="nav-tree">
        <template x-for="group in groups" :key="group.id">
          <div>
            {#- Groups key on `group.id`, not the display name: a term group
                shows its canonical name but filters by term id. The chevron
                stops propagation so it expands without touching the filter. -#}
            <div class="nav-group" :class="{ 'nav-group-active': isGroupActive(group) }" @click="onGroupClick(group)">
              <span class="nav-group-toggle" :class="{ 'nav-group-toggle-open': expandedGroups[group.id] }" @click.stop="toggleGroup(group.id)"></span>
              <span class="nav-group-name" x-text="group.name"></span>
              <span class="nav-group-dismiss" x-show="isGroupActive(group)">×</span>
              <span class="nav-group-count" x-text="group.scenarios.length"></span>
            </div>
            <template x-if="expandedGroups[group.id]">
              <div>
                <template x-for="s in group.scenarios" :key="s.id">
                  <div class="nav-scenario" @click="scrollToAndExpand(s.id)">
                    <span class="nav-status-icon" :class="'dot-' + s.status" x-text="s.status === 'passed' ? '✓' : s.status === 'failed' ? '✗' : '○'"></span>
                    <span x-text="s.narration.text"></span>
                  </div>
                </template>
              </div>
            </template>
          </div>
        </template>
      </div>
    </div>
  </div>
  <div class="view-main">
  <div class="header">
    <div style="display:flex; align-items:baseline; gap:var(--space-lg);">
      <div class="header-title" x-text="filteredCount + ' Scenario' + (filteredCount !== 1 ? 's' : '')"></div>
      <div class="header-context" x-text="filterSummary"></div>
      {#- One chip per active filter, each dismissable on its own. Tags and
          terms intersect (AND) and so can stack; module is single-select. -#}
      <span class="filter-chip" x-show="moduleFilter" x-cloak>
        Module: <span x-text="moduleFilter"></span>
        <button type="button" class="filter-chip-x" @click="clearModuleFilter()" aria-label="Clear module filter">×</button>
      </span>
      <template x-for="tag in tagFilters" :key="tag">
        <span class="filter-chip" x-cloak>
          Tag: <span x-text="tagLabel(tag)"></span>
          <button type="button" class="filter-chip-x" @click="removeTagFilter(tag)" aria-label="Clear tag filter">×</button>
        </span>
      </template>
      <template x-for="termId in termFilters" :key="termId">
        <span class="filter-chip" x-cloak>
          Term: <span x-text="termLabel(termId)"></span>
          <button type="button" class="filter-chip-x" @click="removeTermFilter(termId)" aria-label="Clear term filter">×</button>
        </span>
      </template>
      <button class="collapse-all-btn" @click="toggleAllScenarios()">
        <span x-text="anyScenariosExpanded ? 'Collapse all' : 'Expand all'"></span>
        <span class="collapse-chevron" :class="{ 'collapse-chevron-up': anyScenariosExpanded }"></span>
      </button>
    </div>
  </div>

  {% for scenario in scenarios %}
  {%- set has_body = scenario.steps or scenario.parameters or scenario.error or scenario.skip_reason -%}
  <div class="scenario {{ scenario.status }}"
       x-show="isVisible({{ loop.index0 }})"
       :id="'scenario-' + {{ loop.index0 }}"
       data-scenario-id="{{ scenario.id }}"
       :class="{ 'scenario-expanded': expandedScenarios[{{ loop.index0 }}] }">
    <div class="scenario-header{% if not has_body %} scenario-header-empty{% endif %}"{% if has_body %} @click="toggleScenario({{ loop.index0 }})"{% endif %}>
      <div style="display:flex; align-items:center;">
        {% if has_body %}<span class="scenario-chevron" :class="{ 'scenario-chevron-open': expandedScenarios[{{ loop.index0 }}] }"></span>{% else %}<span class="scenario-chevron-placeholder"></span>{% endif %}
        <span class="scenario-name">{{ scenario.narration | narration }}</span>
        {{ anchor_link('scenario=' ~ scenario_slugs[scenario.id]) }}
      </div>
      <span class="scenario-meta">
        {#- Cap visible tags so a long tag list can't crowd out the title:
            beyond 4 tags, show the first 3 plus a "+N" pill that reveals the
            rest (never a "+1" — it costs as much space as the tag it hides).
            A hidden tag still surfaces while it is the active filter. -#}
        {%- set scenario_idx = loop.index0 -%}
        {%- set collapse_tags = scenario.tags | length > 4 -%}
        {%- set visible_tags = scenario.tags[:3] if collapse_tags else scenario.tags -%}
        {%- set overflow_tags = scenario.tags[3:] if collapse_tags else [] -%}
        {% for tag in visible_tags %}
        <span class="scenario-tag" data-tag="{{ tag }}" :class="{ 'active-tag': tagFilters.includes($el.dataset.tag) }" @click.stop="filterByTag($el.dataset.tag)">{{ tag }}</span>
        {% endfor %}
        {% for tag in overflow_tags %}
        <span class="scenario-tag" x-cloak data-tag="{{ tag }}" x-show="expandedTags[{{ scenario_idx }}] || tagFilters.includes($el.dataset.tag)" :class="{ 'active-tag': tagFilters.includes($el.dataset.tag) }" @click.stop="filterByTag($el.dataset.tag)">{{ tag }}</span>
        {% endfor %}
        {% if overflow_tags %}
        <span class="scenario-tag scenario-tag-more" x-show="!expandedTags[{{ scenario_idx }}]" @click.stop="expandedTags[{{ scenario_idx }}] = true">+{{ overflow_tags | length }}</span>
        {% endif %}
        <span class="scenario-status {{ scenario.status }}">
          {% if scenario.status == 'passed' %}✓ passed{% elif scenario.status == 'failed' %}✗ failed{% else %}○ skipped{% endif %}
        </span>
        <span class="scenario-duration">{{ scenario.duration_ms }}ms</span>
      </span>
    </div>

    <div class="scenario-body" :class="{ expanded: expandedScenarios[{{ loop.index0 }}] }">
    <div class="scenario-body-inner">
      {% if scenario.skip_reason %}
      <div class="skip-reason">
        <span class="skip-reason-label">Skipped:</span>
        <span class="skip-reason-text">{{ scenario.skip_reason }}</span>
      </div>
      {% endif %}
      <div class="steps">
        {%- set scenario_idx = loop.index0 -%}
        {%- set ns = namespace(prev_phase=None) -%}
        {%- for step in scenario.steps -%}
          {%- if step.phase != ns.prev_phase -%}
            <div class="phase-label">{{ step.phase | capitalize }}</div>
            {%- set ns.prev_phase = step.phase -%}
          {%- endif -%}
          <div class="phase-steps">
            {{ render_step(step, 's' ~ scenario_idx ~ '_' ~ loop.index0) }}
          </div>
        {%- endfor -%}
      </div>

      {% if scenario.parameters %}
      {#- A table with an attachment column carries payload panels spanning its
          full width, so it takes the card's width rather than its columns'.
          A table without one stays as wide as its data. -#}
      {% set has_attachment = scenario.parameters.columns | selectattr('kind', 'equalto', 'attachment') | list %}
      <table class="param-table{% if has_attachment %} param-table--full{% endif %}">
        <thead>
          <tr>
            {% for col in scenario.parameters.columns %}
            <th {% if col.kind != 'attachment' %}class="param-color-{{ param_color_map.get(col.name, 0) % num_param_colors }}" {% endif %}data-param="{{ col.id }}"
                @mouseenter="setHoverParam($el.dataset.param, $event.currentTarget)"
                @mouseleave="setHoverParam(null, $event.currentTarget)">{{ col.name }}</th>
            {% endfor %}
            <th style="text-align:right">status</th>
          </tr>
        </thead>
        <tbody>
          {% for case in scenario.parameters.cases %}
          {%- set case_idx = loop.index0 -%}
          <tr class="{{ 'failed-row' if case.status == 'failed' else '' }}"
              @mouseenter="setHoverRow($event.currentTarget)"
              @mouseleave="clearHoverRow($event.currentTarget)">
            {% for col, val in zip(scenario.parameters.columns, case.values) %}
            {% if col.kind == 'attachment' %}
            <td data-param="{{ col.id }}"
                @mouseenter="setHoverParam($el.dataset.param, $event.currentTarget)"
                @mouseleave="setHoverParam(null, $event.currentTarget)">
              {% if val %}
              {# Keyed on the column's position, never on `col.id`: the id is report data and this lands inside an Alpine expression. #}
              {{ attachment_badge('s' ~ scenario_idx ~ '_case' ~ case_idx ~ '_col' ~ loop.index0, col.name) }}
              {% endif %}
            </td>
            {% else %}
            {# `data-subst` only where the cell has something to substitute: a
               generated column is blank for a case that recorded no value, and
               substituting that blank would erase the step's {token} instead of
               replacing it. A `param` cell always substitutes — `None` there is
               a real parametrize value. #}
            <td data-param="{{ col.id }}"{% if col.kind == 'param' or val is not none %} data-subst="{{ col.id }}"{% endif %}
                @mouseenter="setHoverParam($el.dataset.param, $event.currentTarget)"
                @mouseleave="setHoverParam(null, $event.currentTarget)">{% if col.kind == 'param' %}{{ val }}{% else %}{{ val if val is not none else '' }}{% endif %}</td>
            {% endif %}
            {% endfor %}
            <td style="text-align:right">
              {% if case.divergent %}<span class="case-divergent" title="Steps differ from the other cases, so the grouped tree is not this one and its columns stay blank.">≠</span>{% endif %}
              {% if case.status == 'passed' %}<span class="dot-passed">✓</span>{% elif case.status == 'skipped' %}<span class="dot-skipped">○</span>{% else %}<span class="dot-failed">✗</span>{% endif %}
            </td>
          </tr>
          {% if case.error %}
          <tr>
            <td colspan="{{ scenario.parameters.columns | length + 1 }}">
              {{ render_error(case.error) }}
            </td>
          </tr>
          {% endif %}
          {#- A payload opens across the whole table rather than inside its
              cell: an attachment is routinely wider than any column, and a
              cell that holds one both squeezes the columns beside it (the
              collapsed content still sizes the column) and clips what it
              cannot fit. -#}
          {% for col, val in zip(scenario.parameters.columns, case.values) %}
          {% if col.kind == 'attachment' and val %}
          {% set cell_id = 's' ~ scenario_idx ~ '_case' ~ case_idx ~ '_col' ~ loop.index0 %}
          <tr class="attachment-panel-row">
            <td class="attachment-panel" colspan="{{ scenario.parameters.columns | length + 1 }}">
              <div class="attachment-expand" :class="{ expanded: expandedAttachments['{{ cell_id }}'] }">
                <div class="attachment-expand-inner">
                  <div class="attachment-panel-body">
                    {#- The column name alone: the panel opens under its own
                        row, so the case is already on screen — unlike a Markdown
                        block, which is collected below the whole table and needs
                        the case key to say where it belongs. What the caption is
                        for is telling two panels open on one row apart. -#}
                    <div class="attachment-panel-label">{{ col.name }}</div>
                    <div class="attachment-content"><pre>{{ val.content }}</pre></div>
                  </div>
                </div>
              </div>
            </td>
          </tr>
          {% endif %}
          {% endfor %}
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if scenario.error %}
      {{ render_error(scenario.error) }}
      {% endif %}

      {% if scenario.source %}
      <div class="scenario-source">{{ source_link(scenario.source) }}</div>
      {% endif %}
    </div>
    </div>
  </div>
  {% endfor %}

  </div>{# end .view-main #}
  </div>{# end .view-layout #}
  </div>{# end #view-scenarios #}

  <div id="view-stories" x-show="mainView === 'stories'" x-cloak>
  {% if stories %}
  <div class="view-layout">
    <div class="sidebar">
      <div class="sidebar-label">Stories</div>
      {% for story in stories %}
      {% set scns = story_rollups[story.id].scenarios %}
      <div class="story-sidebar-item" data-story-id="{{ story.id }}"
           :class="{ active: selectedStory === $el.dataset.storyId }"
           @click="selectedStory = $el.dataset.storyId">
        <div class="story-sidebar-title">{{ story.title }}</div>
        <div class="story-sidebar-meta">{{ story.activities | length }} activities · {{ scns | length }} scenario{{ 's' if scns | length != 1 else '' }}</div>
      </div>
      {% endfor %}
    </div>
    <div class="view-main">
      {% for story in stories %}
      <div data-story-id="{{ story.id }}" x-show="selectedStory === $el.dataset.storyId">
        {% set rollup = story_rollups[story.id] %}
        {% set story_scns = rollup.scenarios %}
        {% set total_scns = story_scns | length %}
        <div class="header">
          <div style="display:flex; align-items:baseline; gap:var(--space-lg);">
            <div class="header-title">{{ story.title }}{{ anchor_link('view=stories&story=' ~ story.id) }}</div>
            <div class="header-context">{{ story.activities | length }} activities · {{ total_scns }} scenario{{ 's' if total_scns != 1 else '' }}</div>
            <button class="collapse-all-btn" x-show="anyActivitiesHighlighted" x-cloak
                    @click="clearActivityHighlights()">Deselect</button>
          </div>
        </div>
        <div class="activity-timeline">
          {% for activity in story.activities %}
          {% set cov = rollup.per_activity[activity.id] %}
          <div class="activity-row" id="activity-{{ story.id }}-{{ activity.id }}"
               data-activity-id="{{ activity.id }}"
               :class="{ 'activity-row-highlight': highlightedActivities[$el.dataset.activityId] }">
            <div class="activity-num" data-activity-id="{{ activity.id }}"
                 :class="{ 'activity-num-highlight': highlightedActivities[$el.dataset.activityId] }">{{ activity.id }}</div>
            <div class="activity-body">
              {% for path in activity.paths %}
              <div class="activity-path">
                {% for part in path.parts %}{{ part | activity_part }}{% endfor %}
              </div>
              {% endfor %}
            </div>
            <div class="activity-cov">
              {% if not cov.eligible %}
              <span class="cov-chip cov-untracked" title="insufficient number of glossary terms for matching">—</span>
              {% elif cov.total == 0 %}
              <span class="cov-chip cov-uncovered">no coverage</span>
              {% else %}
              {% set cov_class = 'cov-passed' if (cov.failed == 0 and cov.skipped == 0) else ('cov-failed' if cov.failed == cov.total else 'cov-mixed') %}
              <span class="cov-chip {{ cov_class }}">{{ cov.total }} scenario{{ 's' if cov.total != 1 else '' }}{% if cov.failed %} · {{ cov.failed }} failing{% endif %}{% if cov.skipped %} · {{ cov.skipped }} skipped{% endif %}</span>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        <div class="scn-act-strip-section">
          <div class="story-section-heading">Scenarios</div>
          {% for scn in story_scns %}
          <div class="scenario {{ scn.status }}" style="margin-bottom: var(--space-sm);"
               {# Single-quoted: `tojson` escapes `<`, `>`, `&` and `'`, but not
                  the `"` its own string literals need. #}
               data-covers='{{ scn_covers.get(scn.id, []) | tojson }}'
               x-show="activitySelectionMatches(JSON.parse($el.dataset.covers))">
            <div class="scenario-header scenario-header-empty">
              <div style="display:flex; align-items:center;">
                <span class="scenario-name scenario-name--goto"
                      data-goto-scenario="{{ scn.id }}">{{ scn.narration | narration }}</span>
              </div>
              <span class="scenario-meta">
                <span class="scenario-status {{ scn.status }}">
                  {{ '✓ passed' if scn.status == 'passed' else ('✗ failed' if scn.status == 'failed' else '○ skipped') }}
                </span>
              </span>
            </div>
            {% if scn_covers.get(scn.id) %}
            <div class="scn-act-strip">
              <span class="scn-act-label">Covers:</span>
              {% for act_id in scn_covers.get(scn.id, []) %}
              <span class="use-chip" data-activity-id="{{ act_id }}"
                    :class="{ 'use-chip-highlight': highlightedActivities[$el.dataset.activityId] }">{{ act_id }}</span>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% if story.source %}
        <div class="scenario-source">{{ source_link(story.source) }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  </div>
  <div id="view-glossary" x-show="mainView === 'glossary'" x-cloak>
  {% if glossary %}
  <div class="view-layout">
    <div class="sidebar">
      <label class="search-box">
        <svg class="search-box-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="text" placeholder="Search terms..." x-model="glossarySearch">
        <button type="button" class="search-box-clear" @click="glossarySearch = ''" x-show="glossarySearch" aria-label="Clear search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </label>

      {% set actor_count = glossary.terms | selectattr('kind', 'equalto', 'actor') | list | length %}
      {% set object_count = glossary.terms | selectattr('kind', 'equalto', 'object') | list | length %}
      {% set verb_count = glossary.terms | selectattr('kind', 'equalto', 'verb') | list | length %}
      {% set kindless_count = glossary.terms | selectattr('kind', 'none') | list | length %}
      {% set undefined_count = glossary.terms | selectattr('definition', 'none') | list | length %}
      {# When no term is categorized, the kind grouping is pure noise: drop the
         filter section and the 'Uncategorized' header, leaving a flat list. #}
      {% set all_uncategorized = kindless_count and not (actor_count or object_count or verb_count) %}
      {% if not all_uncategorized %}
      <div class="sidebar-section">
        <div class="sidebar-label">Show kinds</div>
        <label class="kind-filter-row">
          <input type="checkbox" x-model="glossaryKindFilter.actor">
          <span class="kind-swatch kind-swatch-actor"></span>
          <span>Actors</span>
          <span class="nav-group-count">{{ actor_count }}</span>
        </label>
        <label class="kind-filter-row">
          <input type="checkbox" x-model="glossaryKindFilter.object">
          <span class="kind-swatch kind-swatch-object"></span>
          <span>Work Objects</span>
          <span class="nav-group-count">{{ object_count }}</span>
        </label>
        <label class="kind-filter-row">
          <input type="checkbox" x-model="glossaryKindFilter.verb">
          <span class="kind-swatch kind-swatch-verb"></span>
          <span>Verbs</span>
          <span class="nav-group-count">{{ verb_count }}</span>
        </label>
        {% if kindless_count %}
        <label class="kind-filter-row">
          <input type="checkbox" x-model="glossaryKindFilter.kindless">
          <span class="kind-swatch kind-swatch-kindless"></span>
          <span>Uncategorized</span>
          <span class="nav-group-count">{{ kindless_count }}</span>
        </label>
        {% endif %}
      </div>
      {% endif %}

      {# When every term is defined, the Definitions filter can only ever be a
         no-op: drop it, mirroring the kind grouping's all_uncategorized hide. #}
      {% if undefined_count %}
      <div class="sidebar-section">
        <div class="sidebar-label">Definitions</div>
        <div class="seg-toggle">
          <div class="seg-btn" :class="{ active: glossaryDefinitionFilter === 'all' }" @click="glossaryDefinitionFilter = 'all'">All</div>
          <div class="seg-btn" :class="{ active: glossaryDefinitionFilter === 'defined' }" @click="glossaryDefinitionFilter = 'defined'">Defined</div>
          <div class="seg-btn" :class="{ active: glossaryDefinitionFilter === 'undefined' }" @click="glossaryDefinitionFilter = 'undefined'">Undefined</div>
        </div>
      </div>
      {% endif %}
    </div>

    <div class="view-main">
      <div class="header">
        <div style="display:flex; align-items:baseline; gap:var(--space-lg);">
          <div class="header-title">Glossary</div>
          <div class="header-context">
            {{ glossary.terms | length }} term{{ 's' if glossary.terms | length != 1 else '' }}{% if not all_uncategorized %} ·
            {{ actor_count }} actor{{ 's' if actor_count != 1 else '' }} ·
            {{ object_count }} work object{{ 's' if object_count != 1 else '' }} ·
            {{ verb_count }} verb{{ 's' if verb_count != 1 else '' }}{% if kindless_count %} ·
            {{ kindless_count }} uncategorized{% endif %}{% endif %}
          </div>
          <button class="collapse-all-btn" @click="toggleAllTerms()">
            <span x-text="anyTermsExpanded ? 'Collapse all references' : 'Expand all references'"></span>
            <span class="collapse-chevron" :class="{ 'collapse-chevron-up': anyTermsExpanded }"></span>
          </button>
        </div>
      </div>

      {% for kind_label, kind_key, kind_cls in [('Actors', 'actor', 'term-actor'), ('Work Objects', 'object', 'term-obj'), ('Verbs', 'verb', 'term-verb'), ('Uncategorized', 'kindless', 'term-kindless')] %}
      {% if kind_key == 'kindless' %}
      {% set kind_terms = glossary.terms | selectattr('kind', 'none') | list %}
      {% else %}
      {% set kind_terms = glossary.terms | selectattr('kind', 'equalto', kind_key) | list %}
      {% endif %}
      {% if kind_terms %}
      <div x-show="glossaryKindFilter.{{ kind_key }}">
        {% if not all_uncategorized %}
        <div class="kind-header">
          <span class="kind-title {{ kind_cls }}">{{ kind_label }}</span>
          <span class="kind-meta">{{ kind_terms | length }} term{{ 's' if kind_terms | length != 1 else '' }}</span>
        </div>
        {% endif %}
        {% for term in kind_terms %}
        {% set agg = glossary_aggregations.get(term.id) %}
        {% set scn_ids = term_scenario_index.get(term.id, []) %}
        {% set show_instances = agg and kind_key in ('actor', 'object') and agg.instances %}
        {% set q = 'glossarySearch' %}
        <div class="entry" id="term-{{ term.id }}"
             data-search="{{ term.canonical | lower }}"
             x-show="(glossaryDefinitionFilter === 'all' || (glossaryDefinitionFilter === 'undefined') === {{ 'true' if term.definition is none else 'false' }}) && (!glossarySearch || $el.dataset.search.includes(glossarySearch.toLowerCase()))">
          <div class="entry-head" data-term-id="{{ term.id }}" @click="expandedTerms[$el.dataset.termId] ? delete expandedTerms[$el.dataset.termId] : (expandedTerms[$el.dataset.termId] = true)">
            <span class="scenario-chevron" data-term-id="{{ term.id }}" :class="{ 'scenario-chevron-open': expandedTerms[$el.dataset.termId] }"></span>
            <span class="entry-name">
              <span class="term-pill {{ kind_cls }}">{{ term.canonical }}</span>
            </span>
            <div class="entry-body">
              <div class="entry-def">{{ term.definition | inline_md }}<span class="entry-def-badge" {% if term.definition %}style="display:none"{% endif %}>Undefined</span></div>
              <div class="entry-summary">
                {% set summary_parts = [] %}
                {% if show_instances %}
                {% set n = agg.instances | length %}
                {% set _ = summary_parts.append('%d instance%s' | format(n, 's' if n != 1 else '')) %}
                {% endif %}
                {% if agg and agg.stories %}
                {% set n = agg.stories | length %}
                {% set _ = summary_parts.append('%d stor%s' | format(n, 'ies' if n != 1 else 'y')) %}
                {% endif %}
                {% if scn_ids %}
                {% set n = scn_ids | length %}
                {% set _ = summary_parts.append('%d scenario%s' | format(n, 's' if n != 1 else '')) %}
                {% endif %}
                {{ summary_parts | join(' · ') }}
              </div>
            </div>
            {{ anchor_link('view=glossary&term=' ~ term.id) }}
          </div>
          <div class="refs scenario-body" data-term-id="{{ term.id }}" :class="{ expanded: expandedTerms[$el.dataset.termId] }">
            <div class="refs-inner scenario-body-inner">
              <div class="refs-content">
                {% if agg and agg.stories %}
                <div class="refs-line">
                  <span class="refs-label">Stories:</span>
                  {% for sid in agg.stories %}
                  <a class="use-chip" href="#" data-story-id="{{ sid }}" @click.prevent="mainView = 'stories'; selectedStory = $el.dataset.storyId">{{ sid }}</a>
                  {% endfor %}
                </div>
                {% endif %}
                {% if show_instances %}
                <div class="refs-line">
                  <span class="refs-label">Instances:</span>
                  {% for inst in agg.instances %}
                  <span class="use-chip use-chip--static">{{ inst.display }}</span>
                  {% endfor %}
                </div>
                {% endif %}
                {% if agg and kind_key == 'verb' and agg.forms %}
                <div class="refs-line">
                  <span class="refs-label">Also used as:</span>
                  {% for form in agg.forms %}
                  <span class="use-chip use-chip--static">{{ form.display }}</span>
                  {% endfor %}
                </div>
                {% endif %}
                {% if scn_ids %}
                <div class="refs-line">
                  <a class="use-chip" href="#" data-term-id="{{ term.id }}"
                     @click.prevent="filterScenariosByTerm($el.dataset.termId)">
                    Show {{ scn_ids | length }} scenario{{ 's' if scn_ids | length != 1 else '' }} using this term
                  </a>
                </div>
                {% endif %}
                {% if term.source %}
                <div class="scenario-source">{{ source_link(term.source) }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  {% endif %}
  </div>

</div>

<!-- Shared hover tooltip for term-ref pills; positioned by app.js. Lives at
     body level so it is never clipped by collapsible scenario bodies. -->
<div id="term-tip" role="tooltip" hidden>
  <span class="term-tip-name"></span>
  <span class="term-tip-def"></span>
</div>

<script>
window.__REPORT_DATA__ = {{ report_json }};
window.__storyIds = {{ story_ids_json }};
window.__termIds = {{ term_ids_json }};
window.__termScenarios = {{ term_scenarios_json }};
window.__scenarioSlugs = {{ scenario_slugs_json }};
{{ app_js }}
</script>
<script>{{ alpine_js }}</script>
</body>
</html>
