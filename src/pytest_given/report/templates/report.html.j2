<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ metadata.title or metadata.project }} — pytest-given Report</title>
<style>
{{ css }}
{# One rule per parametrize column, generated for this report's column count.
   See report/palette.py for how the ring is derived; styles.css holds only the
   properties every column shares. The `th` half of each selector is there to
   outrank `.param-table th`, which sets a color of its own. #}
{%- for color in param_colors %}
.param-color-{{ loop.index0 }}, th.param-color-{{ loop.index0 }} { color: {{ color }}; }
{%- endfor %}
</style>
</head>
<body x-data="reportApp()" :style="'--sidebar-w: ' + sidebarWidth + 'px'">

<div class="main">

  {%- from '_macros.html.j2' import source_link, anchor_link, render_error, attachment_icon, attachment_badge, expandable_attachment, render_step, sidebar_resizer, status_badge, status_dot with context -%}

  <header class="topbar">
    <div class="topbar-title">{{ metadata.title or metadata.project }}</div>
    <div class="topbar-meta">pytest {{ metadata.pytest_version }} · pytest-given {{ metadata.plugin_version }} · <span x-text="formattedTimestamp"></span></div>
  </header>

  {#- The view divs read this too: `role="tabpanel"` only where a tablist
      exists to belong to. -#}
  {%- set visible_count = tab_visibility.visible_count -%}
  {% if visible_count > 1 %}
  {#- The class paints the active tab; `aria-selected` announces it. No roving
      tabindex: three tabs do not earn the arrow-key handling. -#}
  <nav class="frame-nav" role="tablist" aria-label="Report views">
    <button class="nav-tab" role="tab" id="tab-scenarios" aria-controls="view-scenarios"
            :class="{ 'nav-tab-active': mainView === 'scenarios' }"
            :aria-selected="mainView === 'scenarios'"
            @click="mainView = 'scenarios'">Scenarios</button>
    {% if tab_visibility.stories %}
    <button class="nav-tab" role="tab" id="tab-stories" aria-controls="view-stories"
            :class="{ 'nav-tab-active': mainView === 'stories' }"
            :aria-selected="mainView === 'stories'"
            @click="mainView = 'stories'">Stories</button>
    {% endif %}
    {% if tab_visibility.glossary %}
    <button class="nav-tab" role="tab" id="tab-glossary" aria-controls="view-glossary"
            :class="{ 'nav-tab-active': mainView === 'glossary' }"
            :aria-selected="mainView === 'glossary'"
            @click="mainView = 'glossary'">Glossary</button>
    {% endif %}
  </nav>
  {% endif %}

  <div id="view-scenarios" {% if visible_count > 1 %}role="tabpanel" aria-labelledby="tab-scenarios"{% endif %} x-show="mainView === 'scenarios'">
  <div class="view-layout">
  <div class="sidebar">
    <label class="search-box">
      <svg class="search-box-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="text" placeholder="Search names and tags..." x-model="search">
      <button type="button" class="search-box-clear" @click="search = ''" x-show="search" aria-label="Clear search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </label>

    <div class="sidebar-section">
      <div class="sidebar-label">Status</div>
      <div class="status-pills">
        <button type="button" class="btn-reset status-pill" :class="{ 'active-passed': showPassed }" :aria-pressed="showPassed" @click="showPassed = !showPassed">✓ Passed <span x-text="counts.passed"></span></button>
        <button type="button" class="btn-reset status-pill" :class="{ 'active-failed': showFailed }" :aria-pressed="showFailed" @click="showFailed = !showFailed">✗ Failed <span x-text="counts.failed"></span></button>
        <button type="button" class="btn-reset status-pill" :class="{ 'active-skipped': showSkipped }" :aria-pressed="showSkipped" @click="showSkipped = !showSkipped" x-show="counts.skipped > 0">○ Skipped <span x-text="counts.skipped"></span></button>
      </div>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-label-row">
        <div class="sidebar-label">Browse by</div>
        {#- Sort applies to the group rows below, whatever axis is showing:
            "A–Z" reads the name column, "Count" the count column. -#}
        <div class="sort-toggle">
          <button type="button" class="sort-btn" :class="{ 'sort-btn-active': sortBy === 'name' }"
                  :aria-pressed="sortBy === 'name'" @click="sortBy = 'name'"
                  aria-label="Sort groups by name">A&ndash;Z</button>
          <button type="button" class="sort-btn" :class="{ 'sort-btn-active': sortBy === 'count' }"
                  :aria-pressed="sortBy === 'count'" @click="sortBy = 'count'"
                  aria-label="Sort groups by scenario count">Count</button>
        </div>
      </div>
      <div class="seg-toggle">
        {#- Modules leads and opens by default: it is the one axis every report
            has, so no report opens on an empty tree. The Terms axis needs a
            glossary to browse; without one the segment is simply absent. -#}
        <button type="button" class="btn-reset seg-btn" :class="{ active: view === 'modules' }" :aria-pressed="view === 'modules'" @click="view = 'modules'">Modules</button>
        {% if tab_visibility.glossary %}
        <button type="button" class="btn-reset seg-btn" :class="{ active: view === 'terms' }" :aria-pressed="view === 'terms'" @click="view = 'terms'">Terms</button>
        {% endif %}
        <button type="button" class="btn-reset seg-btn" :class="{ active: view === 'tags' }" :aria-pressed="view === 'tags'" @click="view = 'tags'">Tags</button>
      </div>
      <div class="nav-tree">
        {#- Rows key on `group.id`, not the display name: a term row shows its
            canonical name but filters by term id, and a module row shows one
            path segment but filters by the whole path. The row filters and the
            chevron expands — the chevron stops propagation so it opens a
            package without filtering by it, and selecting a package opens it
            too (see `onGroupClick`), so the common case needs no aim. Only a
            module package has children, so only it renders a chevron.
            `--nav-indent` is what makes the flat row list read as a tree.
            The row keeps its own @click so the padding stays clickable; the
            inner button is what the keyboard reaches, and stops propagation so
            the two do not both fire. -#}
        <template x-for="group in groups" :key="group.id">
          <div class="nav-group" :class="{ 'nav-group-active': isGroupActive(group) }"
               :style="'--nav-indent:' + (group.depth * 12) + 'px'" @click="onGroupClick(group)">
            <button type="button" class="nav-group-toggle" x-show="group.hasChildren"
                    :class="{ 'nav-group-toggle-open': expandedGroups[group.id] }"
                    :aria-expanded="!!expandedGroups[group.id]"
                    :aria-label="(expandedGroups[group.id] ? 'Collapse ' : 'Expand ') + group.name"
                    @click.stop="toggleGroup(group.id)"></button>
            <span class="nav-group-toggle-placeholder" x-show="!group.hasChildren && view === 'modules'"></span>
            <button type="button" class="btn-reset nav-group-select"
                    :aria-pressed="isGroupActive(group)"
                    @click.stop="onGroupClick(group)">
              <span class="nav-group-name" x-text="group.name"></span>
              <span class="nav-group-count" x-text="group.count"></span>
            </button>
          </div>
        </template>
      </div>
    </div>
  </div>
  {{ sidebar_resizer() }}
  <div class="view-main">
  <div class="header">
    <div style="display:flex; align-items:baseline; gap:var(--space-lg);">
      <div class="header-title" x-text="filteredCount + ' Scenario' + (filteredCount !== 1 ? 's' : '')"></div>
      <div class="header-context" x-text="filterSummary"></div>
      {#- One chip per active filter, each dismissable on its own. Tags and
          terms intersect (AND) and so can stack; module is single-select. -#}
      <span class="filter-chip" x-show="moduleFilter" x-cloak>
        Module: <span x-text="moduleFilter"></span>
        <button type="button" class="filter-chip-x" @click="clearModuleFilter()" aria-label="Clear module filter">×</button>
      </span>
      <template x-for="tag in tagFilters" :key="tag">
        <span class="filter-chip" x-cloak>
          Tag: <span x-text="tagLabel(tag)"></span>
          <button type="button" class="filter-chip-x" @click="removeTagFilter(tag)" aria-label="Clear tag filter">×</button>
        </span>
      </template>
      <template x-for="termId in termFilters" :key="termId">
        <span class="filter-chip" x-cloak>
          Term: <span x-text="termLabel(termId)"></span>
          <button type="button" class="filter-chip-x" @click="removeTermFilter(termId)" aria-label="Clear term filter">×</button>
        </span>
      </template>
      {#- The activity label is a whole sentence, so it truncates and carries
          the full prose in a title rather than pushing the chips off the row. -#}
      <span class="filter-chip" x-show="activityFilter" x-cloak>
        <span class="filter-chip-text" x-text="activityLabel(activityFilter)" :title="activityLabel(activityFilter)"></span>
        <button type="button" class="filter-chip-x" @click="clearActivityFilter()" aria-label="Clear activity filter">×</button>
      </span>
      <button class="collapse-all-btn" @click="toggleAllScenarios()">
        <span x-text="anyScenariosExpanded ? 'Collapse all' : 'Expand all'"></span>
        <span class="collapse-chevron" :class="{ 'collapse-chevron-up': anyScenariosExpanded }"></span>
      </button>
    </div>
  </div>

  {% for scenario in scenarios %}
  {%- set has_body = scenario.steps or scenario.parameters or scenario.error or scenario.skip_reason -%}
  <div class="scenario {{ scenario.status }}"
       x-show="isVisible({{ loop.index0 }})"
       id="scenario-{{ loop.index0 }}"
       data-scenario-id="{{ scenario.id }}"
       :class="{ 'scenario-expanded': expandedScenarios[{{ loop.index0 }}] }">
    <div class="scenario-header{% if not has_body %} scenario-header-empty{% endif %}"{% if has_body %} @click="toggleScenario({{ loop.index0 }})"{% endif %}>
      <div style="display:flex; align-items:center;">
        {% if has_body %}<button type="button" class="disclosure-btn" aria-controls="scenario-body-{{ loop.index0 }}" :aria-expanded="!!expandedScenarios[{{ loop.index0 }}]" :aria-label="(expandedScenarios[{{ loop.index0 }}] ? 'Collapse' : 'Expand') + ' scenario'" @click.stop="toggleScenario({{ loop.index0 }})"><span class="scenario-chevron" :class="{ 'scenario-chevron-open': expandedScenarios[{{ loop.index0 }}] }"></span></button>{% else %}<span class="scenario-chevron-placeholder"></span>{% endif %}
        <span class="scenario-name">{{ scenario.narration | narration }}</span>
        {{ anchor_link('scenario=' ~ scenario_slugs[scenario.id]) }}
      </div>
      <span class="scenario-meta">
        {#- Cap visible tags so a long tag list can't crowd out the title:
            beyond 4 tags, show the first 3 plus a "+N" pill that reveals the
            rest (never a "+1" — it costs as much space as the tag it hides).
            A hidden tag still surfaces while it is the active filter. -#}
        {%- set scenario_idx = loop.index0 -%}
        {%- set collapse_tags = scenario.tags | length > 4 -%}
        {%- set visible_tags = scenario.tags[:3] if collapse_tags else scenario.tags -%}
        {%- set overflow_tags = scenario.tags[3:] if collapse_tags else [] -%}
        {% for tag in visible_tags %}
        <button type="button" class="btn-reset scenario-tag" data-tag="{{ tag }}" :class="{ 'active-tag': tagFilters.includes($el.dataset.tag) }" :aria-pressed="tagFilters.includes($el.dataset.tag)" @click.stop="filterByTag($el.dataset.tag)">{{ tag }}</button>
        {% endfor %}
        {% for tag in overflow_tags %}
        <button type="button" class="btn-reset scenario-tag" x-cloak data-tag="{{ tag }}" x-show="expandedTags[{{ scenario_idx }}] || tagFilters.includes($el.dataset.tag)" :class="{ 'active-tag': tagFilters.includes($el.dataset.tag) }" :aria-pressed="tagFilters.includes($el.dataset.tag)" @click.stop="filterByTag($el.dataset.tag)">{{ tag }}</button>
        {% endfor %}
        {% if overflow_tags %}
        <button type="button" class="btn-reset scenario-tag scenario-tag-more" x-show="!expandedTags[{{ scenario_idx }}]" aria-label="Show {{ overflow_tags | length }} more tags" @click.stop="expandedTags[{{ scenario_idx }}] = true">+{{ overflow_tags | length }}</button>
        {% endif %}
        {{ status_badge(scenario.status) }}
        <span class="scenario-duration">{{ scenario.duration_ms }}ms</span>
      </span>
    </div>

    <div class="scenario-body" id="scenario-body-{{ loop.index0 }}" :class="{ expanded: expandedScenarios[{{ loop.index0 }}] }">
    <div class="scenario-body-inner">
      {% if scenario.skip_reason %}
      <div class="skip-reason">
        <span class="skip-reason-label">Skipped:</span>
        <span class="skip-reason-text">{{ scenario.skip_reason }}</span>
      </div>
      {% endif %}
      <div class="steps">
        {%- set scenario_idx = loop.index0 -%}
        {%- set ns = namespace(prev_phase=None) -%}
        {%- for step in scenario.steps -%}
          {%- if step.phase != ns.prev_phase -%}
            <div class="phase-label">{{ step.phase | capitalize }}</div>
            {%- set ns.prev_phase = step.phase -%}
          {%- endif -%}
          <div class="phase-steps">
            {{ render_step(step, 's' ~ scenario_idx ~ '_' ~ loop.index0) }}
          </div>
        {%- endfor -%}
      </div>

      {% if scenario.parameters %}
      <div class="param-table-scroll">
      <table class="param-table">
        <thead>
          <tr>
            {% for col in scenario.parameters.columns %}
            <th {% if col | param_color_class %}class="{{ col | param_color_class }}" {% endif %}data-param="{{ col.id }}">{{ col.name }}</th>
            {% endfor %}
            <th style="text-align:right">status</th>
          </tr>
        </thead>
        <tbody>
          {% for case in scenario.parameters.cases %}
          {%- set case_idx = loop.index0 -%}
          <tr data-case-row class="{{ 'failed-row' if case.status == 'failed' else '' }}">
            {% for col, val in scenario.parameters.cells(case) %}
            {% if col.kind == 'attachment' %}
            <td data-param="{{ col.id }}">
              {% if val %}
              {# Keyed on the column's position, never on `col.id`: the id is report data and this lands inside an Alpine expression. #}
              {{ attachment_badge('s' ~ scenario_idx ~ '_case' ~ case_idx ~ '_col' ~ loop.index0, col.name, val.content_type) }}
              {% endif %}
            </td>
            {% else %}
            {# `data-subst` only where the cell has something to substitute: a
               generated column is blank for a case that recorded no value, and
               substituting that blank would erase the step's {token} instead of
               replacing it. A `param` cell always substitutes — `None` there is
               a real parametrize value. #}
            <td data-param="{{ col.id }}"{% if col.kind == 'param' or val is not none %} data-subst="{{ col.id }}"{% endif %}>{% if col.kind == 'param' %}{{ val }}{% else %}{{ val if val is not none else '' }}{% endif %}</td>
            {% endif %}
            {% endfor %}
            <td style="text-align:right">
              {{ status_dot(case.status) }}
            </td>
          </tr>
          {% if case.error %}
          <tr>
            <td colspan="{{ scenario.parameters.columns | length + 1 }}">
              {{ render_error(case.error) }}
            </td>
          </tr>
          {% endif %}
          {#- A payload opens across the whole table rather than inside its
              cell: an attachment is routinely wider than any column, and a
              cell that holds one both squeezes the columns beside it (the
              collapsed content still sizes the column) and clips what it
              cannot fit. -#}
          {% for col, val in scenario.parameters.cells(case) %}
          {% if col.kind == 'attachment' and val %}
          {% set cell_id = 's' ~ scenario_idx ~ '_case' ~ case_idx ~ '_col' ~ loop.index0 %}
          <tr class="attachment-panel-row">
            <td class="attachment-panel" colspan="{{ scenario.parameters.columns | length + 1 }}">
              <div class="attachment-expand" :class="{ expanded: expandedAttachments['{{ cell_id }}'] }">
                <div class="attachment-expand-inner">
                  <div class="attachment-panel-body">
                    {#- The column name alone: the panel opens under its own
                        row, so the case is already on screen — unlike a Markdown
                        block, which is collected below the whole table and needs
                        the case key to say where it belongs. What the caption is
                        for is telling two panels open on one row apart. -#}
                    <div class="attachment-panel-label">{{ col.name }}</div>
                    <div class="attachment-content"><pre>{{ val.content }}</pre></div>
                  </div>
                </div>
              </div>
            </td>
          </tr>
          {% endif %}
          {% endfor %}
          {% endfor %}
        </tbody>
      </table>
      </div>
      {% endif %}

      {% if scenario.error %}
      {{ render_error(scenario.error) }}
      {% endif %}

      {% if scenario.source %}
      <div class="scenario-source">{{ source_link(scenario.source) }}</div>
      {% endif %}
    </div>
    </div>
  </div>
  {% endfor %}

  </div>{# end .view-main #}
  </div>{# end .view-layout #}
  </div>{# end #view-scenarios #}

  <div id="view-stories" {% if visible_count > 1 %}role="tabpanel" aria-labelledby="tab-stories"{% endif %} x-show="mainView === 'stories'" x-cloak>
  {% if stories %}
  <div class="view-layout">
    <div class="sidebar">
      <div class="sidebar-label">Stories</div>
      {% for story in stories %}
      {% set scns = story_rollups[story.id].scenarios %}
      <button type="button" class="btn-reset story-sidebar-item" data-story-id="{{ story.id }}"
              :class="{ active: selectedStory === $el.dataset.storyId }"
              :aria-pressed="selectedStory === $el.dataset.storyId"
              @click="selectStory($el.dataset.storyId)">
        <div class="story-sidebar-title">{{ story.title }}</div>
        <div class="story-sidebar-meta">{{ story.activities | length }} activities · {{ scns | length | plural('scenario') }}</div>
      </button>
      {% endfor %}
    </div>
    {{ sidebar_resizer() }}
    <div class="view-main">
      {% for story in stories %}
      <div data-story-id="{{ story.id }}" x-show="selectedStory === $el.dataset.storyId">
        {% set rollup = story_rollups[story.id] %}
        {% set story_scns = rollup.scenarios %}
        {% set total_scns = story_scns | length %}
        <div class="header">
          <div style="display:flex; align-items:baseline; gap:var(--space-lg);">
            <div class="header-title">{{ story.title }}{{ anchor_link('view=stories&story=' ~ story.id) }}</div>
            <div class="header-context">{{ story.activities | length }} activities · {{ total_scns | plural('scenario') }}</div>
            <button class="collapse-all-btn" x-show="anyActivitiesHighlighted" x-cloak
                    @click="clearActivityHighlights()">Deselect</button>
          </div>
        </div>
        <div class="activity-timeline">
          {% for activity in story.activities %}
          {% set cov = rollup.per_activity[activity.id] %}
          <div class="activity-row" id="activity-{{ story.id }}-{{ activity.id }}"
               data-activity-id="{{ activity.id }}"
               :class="{ 'activity-row-highlight': highlightedActivities[$el.dataset.activityId] }">
            <button type="button" class="btn-reset activity-num" data-activity-id="{{ activity.id }}"
                    :class="{ 'activity-num-highlight': highlightedActivities[$el.dataset.activityId] }"
                    :aria-pressed="!!highlightedActivities[$el.dataset.activityId]"
                    aria-label="Select activity {{ activity.id }}">{{ activity.id }}</button>
            <div class="activity-body">
              {% for path in activity.paths %}
              <div class="activity-path">
                {% for part in path.parts %}{{ part | activity_part }}{% endfor %}
              </div>
              {% endfor %}
            </div>
            <div class="activity-cov">
              {% if cov.untracked %}
              <span class="cov-chip cov-untracked" title="insufficient number of glossary terms for matching">—</span>
              {% elif cov.total == 0 %}
              <span class="cov-chip cov-uncovered">no coverage</span>
              {% else %}
              {% set cov_class = 'cov-passed' if (cov.failed == 0 and cov.skipped == 0) else ('cov-failed' if cov.failed == cov.total else 'cov-mixed') %}
              <span class="cov-chip {{ cov_class }}">{{ cov.total | plural('scenario') }}{% if cov.failed %} · {{ cov.failed }} failing{% endif %}{% if cov.skipped %} · {{ cov.skipped }} skipped{% endif %}</span>
              {% endif %}
              {#- Revealed by CSS once the row is selected (see .activity-jump),
                  so the row keeps one meaning per click: the row selects, this
                  leaves for the Scenarios view. Only where there is something
                  to show — an uncovered activity would land on an empty list. -#}
              {% if cov.total %}
              <button type="button" class="use-chip activity-jump"
                      data-activity-jump="{{ activity_key(story.id, activity.id) }}">Open in Scenarios <span aria-hidden="true">→</span></button>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        <div class="scn-act-strip-section">
          <div class="story-section-heading">Scenarios</div>
          {% for scn in story_scns %}
          <div class="scenario {{ scn.status }}" style="margin-bottom: var(--space-sm);"
               {# Single-quoted: `tojson` escapes `<`, `>`, `&` and `'`, but not
                  the `"` its own string literals need. #}
               data-covers='{{ scn_covers.get(scn.id, []) | tojson }}'
               x-show="activitySelectionMatches(JSON.parse($el.dataset.covers))">
            <div class="scenario-header scenario-header-empty">
              <div style="display:flex; align-items:center;">
                <button type="button" class="btn-reset scenario-name scenario-name--goto"
                        data-goto-scenario="{{ scn.id }}">{{ scn.narration | narration }}</button>
              </div>
              <span class="scenario-meta">
                {{ status_badge(scn.status) }}
              </span>
            </div>
            {% if scn_covers.get(scn.id) %}
            <div class="scn-act-strip">
              <span class="scn-act-label">Covers:</span>
              {% for act_id in scn_covers.get(scn.id, []) %}
              <button type="button" class="btn-reset use-chip" data-activity-id="{{ act_id }}"
                      :class="{ 'use-chip-highlight': highlightedActivities[$el.dataset.activityId] }"
                      :aria-pressed="!!highlightedActivities[$el.dataset.activityId]"
                      aria-label="Select activity {{ act_id }}">{{ act_id }}</button>
              {% endfor %}
            </div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% if story.source %}
        <div class="scenario-source">{{ source_link(story.source) }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  </div>
  <div id="view-glossary" {% if visible_count > 1 %}role="tabpanel" aria-labelledby="tab-glossary"{% endif %} x-show="mainView === 'glossary'" x-cloak>
  {% if glossary %}
  <div class="view-layout">
    <div class="sidebar">
      <label class="search-box">
        <svg class="search-box-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="text" placeholder="Search terms..." x-model="glossarySearch">
        <button type="button" class="search-box-clear" @click="glossarySearch = ''" x-show="glossarySearch" aria-label="Clear search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </label>

      {% set undefined_count = glossary_view.undefined_count %}
      {% set all_uncategorized = glossary_view.all_uncategorized %}
      {% if not all_uncategorized %}
      <div class="sidebar-section">
        <div class="sidebar-label">Show kinds</div>
        {% for kind in glossary_view.kinds %}
        <label class="kind-filter-row">
          <input type="checkbox" x-model="glossaryKindFilter.{{ kind.key }}">
          <span class="kind-swatch kind-swatch-{{ kind.key }}"></span>
          <span>{{ kind.label }}</span>
          <span class="nav-group-count">{{ kind.count }}</span>
        </label>
        {% endfor %}
      </div>
      {% endif %}

      {# When every term is defined, the Definitions filter can only ever be a
         no-op: drop it, mirroring the kind grouping's all_uncategorized hide. #}
      {% if undefined_count %}
      <div class="sidebar-section">
        <div class="sidebar-label">Definitions</div>
        <div class="seg-toggle">
          <button type="button" class="btn-reset seg-btn" :class="{ active: glossaryDefinitionFilter === 'all' }" :aria-pressed="glossaryDefinitionFilter === 'all'" @click="glossaryDefinitionFilter = 'all'">All</button>
          <button type="button" class="btn-reset seg-btn" :class="{ active: glossaryDefinitionFilter === 'defined' }" :aria-pressed="glossaryDefinitionFilter === 'defined'" @click="glossaryDefinitionFilter = 'defined'">Defined</button>
          <button type="button" class="btn-reset seg-btn" :class="{ active: glossaryDefinitionFilter === 'undefined' }" :aria-pressed="glossaryDefinitionFilter === 'undefined'" @click="glossaryDefinitionFilter = 'undefined'">Undefined</button>
        </div>
      </div>
      {% endif %}
    </div>
    {{ sidebar_resizer() }}

    <div class="view-main">
      <div class="header">
        <div style="display:flex; align-items:baseline; gap:var(--space-lg);">
          <div class="header-title">Glossary</div>
          <div class="header-context">
            {{ glossary.terms | length | plural('term') }}{% if not all_uncategorized %}{% for kind in glossary_view.kinds %} ·
            {{ kind.summary }}{% endfor %}{% endif %}
          </div>
          <button class="collapse-all-btn" @click="toggleAllTerms()">
            <span x-text="anyTermsExpanded ? 'Collapse all references' : 'Expand all references'"></span>
            <span class="collapse-chevron" :class="{ 'collapse-chevron-up': anyTermsExpanded }"></span>
          </button>
        </div>
      </div>

      {% for group in glossary_view.groups %}
      {% set kind_label, kind_key, kind_cls = group.label, group.key, group.css_class %}
      <div x-show="glossaryKindFilter.{{ kind_key }} && visibleTermCount('{{ kind_key }}') > 0">
        {% if not all_uncategorized %}
        <div class="kind-header">
          <span class="kind-title {{ kind_cls }}">{{ kind_label }}</span>
          <span class="kind-meta" x-text="visibleTermLabel('{{ kind_key }}')"></span>
        </div>
        {% endif %}
        {% for entry in group.entries %}
        {% set term = entry.term %}
        {% set agg = entry.aggregation %}
        {% set scn_ids = entry.scenario_ids %}
        {% set show_instances = entry.show_instances %}
        {% set show_forms = entry.show_forms %}
        <div class="entry" id="term-{{ term.id }}"
             data-search="{{ term.canonical | lower }}"
             x-show="(glossaryDefinitionFilter === 'all' || (glossaryDefinitionFilter === 'undefined') === {{ 'true' if term.definition is none else 'false' }}) && (!glossarySearch || $el.dataset.search.includes(glossarySearch.toLowerCase()))">
          <div class="entry-head" data-term-id="{{ term.id }}" @click="toggleTerm($el.dataset.termId)">
            <button type="button" class="disclosure-btn" data-term-id="{{ term.id }}"
                    aria-controls="term-refs-{{ term.id }}"
                    :aria-expanded="!!expandedTerms[$el.dataset.termId]"
                    :aria-label="(expandedTerms[$el.dataset.termId] ? 'Collapse' : 'Expand') + ' references'"
                    @click.stop="toggleTerm($el.dataset.termId)"><span class="scenario-chevron" data-term-id="{{ term.id }}" :class="{ 'scenario-chevron-open': expandedTerms[$el.dataset.termId] }"></span></button>
            <span class="entry-name">
              <span class="term-pill {{ kind_cls }}">{{ term.canonical }}</span>
            </span>
            <div class="entry-body">
              <div class="entry-def">{{ term.definition | inline_md }}<span class="entry-def-badge" {% if term.definition %}style="display:none"{% endif %}>Undefined</span></div>
              <div class="entry-summary">{{ entry.summary }}</div>
            </div>
            {{ anchor_link('view=glossary&term=' ~ term.id) }}
          </div>
          <div class="refs scenario-body" id="term-refs-{{ term.id }}" data-term-id="{{ term.id }}" :class="{ expanded: expandedTerms[$el.dataset.termId] }">
            <div class="refs-inner scenario-body-inner">
              <div class="refs-content">
                {% if agg.stories %}
                <div class="refs-line">
                  <span class="refs-label">Stories:</span>
                  {% for sid in agg.stories %}
                  <a class="use-chip" href="#" data-story-id="{{ sid }}" @click.prevent="mainView = 'stories'; selectStory($el.dataset.storyId)">{{ sid }}</a>
                  {% endfor %}
                </div>
                {% endif %}
                {% if show_instances %}
                <div class="refs-line">
                  <span class="refs-label">Instances:</span>
                  {% for inst in agg.instances %}
                  <span class="use-chip use-chip--static">{{ inst.display }}</span>
                  {% endfor %}
                </div>
                {% endif %}
                {% if show_forms %}
                <div class="refs-line">
                  <span class="refs-label">Also used as:</span>
                  {% for form in agg.forms %}
                  <span class="use-chip use-chip--static">{{ form }}</span>
                  {% endfor %}
                </div>
                {% endif %}
                {% if scn_ids %}
                <div class="refs-line">
                  <a class="use-chip" href="#" data-term-id="{{ term.id }}"
                     @click.prevent="filterScenariosByTerm($el.dataset.termId)">
                    Show {{ scn_ids | length | plural('scenario') }} using this term
                  </a>
                </div>
                {% endif %}
                {% if term.source %}
                <div class="scenario-source">{{ source_link(term.source) }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
      <div class="glossary-empty" x-show="!anyTermsVisible" x-cloak>No terms match this filter.</div>
    </div>
  </div>
  {% endif %}
  </div>

</div>

<!-- Shared hover tooltip for term refs; positioned by app.js. Lives at
     body level so it is never clipped by collapsible scenario bodies. -->
<div id="term-tip" role="tooltip" hidden>
  <span class="term-tip-name"></span>
  <span class="term-tip-def"></span>
</div>

<script>
window.__REPORT_DATA__ = {{ app_data_js }};
{{ app_js }}
</script>
<script>{{ alpine_js }}</script>
</body>
</html>
